;; [Phase0]
;; process_proposer_slashing
;;  mutates: .VALIDATORS[].EXIT_EPOCH, .VALIDATORS[].WITHDRAWABLE_EPOCH, .SLASHINGS, .BALANCES

relation ProcessProposerSlashing:
  beaconState proposerSlashing ~> beaconState
  hint(input %0 %1)

rule ProcessProposerSlashing:
  state proposerSlashing ~> state_slashed
  -- if beaconBlockHeader_1 = proposerSlashing.SIGNED_HEADER_1.MESSAGE
  -- if beaconBlockHeader_2 = proposerSlashing.SIGNED_HEADER_2.MESSAGE
  ;; assert 1
  -- if beaconBlockHeader_1.SLOT = beaconBlockHeader_2.SLOT
  ;; assert 2
  -- if beaconBlockHeader_1.PROPOSER_INDEX = beaconBlockHeader_2.PROPOSER_INDEX
  ;; assert 3
  -- if beaconBlockHeader_1 =/= beaconBlockHeader_2
  -- if vid_proposer = beaconBlockHeader_1.PROPOSER_INDEX
  ;; inserted guard
  -- if $(vid_proposer < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid_proposer] = validator_proposer
  ;; assert 4
  -- if $is_slashable_validator(validator_proposer, $get_current_epoch(state))
  ----
  ;; loop iter1
  -- if signedBeaconBlockHeader_1 = proposerSlashing.SIGNED_HEADER_1
  -- if $compute_epoch_at_slot(signedBeaconBlockHeader_1.MESSAGE.SLOT) = epoch_h1
  -- if $get_domain(state, $DOMAIN_BEACON_PROPOSER, epoch_h1) = domain_h1
  -- if $compute_signing_root_beaconBlockHeader(signedBeaconBlockHeader_1.MESSAGE, domain_h1) = root_sign_h1
  ;; assert 5-1
  -- if $bls_verify(validator_proposer.PUBKEY, root_sign_h1, signedBeaconBlockHeader_1.SIGNATURE)
  ----
  ;; loop iter 2
  -- if signedBeaconBlockHeader_2 = proposerSlashing.SIGNED_HEADER_2
  -- if $compute_epoch_at_slot(signedBeaconBlockHeader_2.MESSAGE.SLOT) = epoch_h2
  -- if $get_domain(state, $DOMAIN_BEACON_PROPOSER, epoch_h2) = domain_h2
  -- if $compute_signing_root_beaconBlockHeader(signedBeaconBlockHeader_2.MESSAGE, domain_h2) = root_sign_h2
  ;; assert 5-2
  -- if $bls_verify(validator_proposer.PUBKEY, root_sign_h2, signedBeaconBlockHeader_2.SIGNATURE)
  ----
  -- SlashValidator: state SLASH `[ vid_proposer `] BY eps ~> state_slashed

relation ProcessProposerSlashings:
  beaconState proposerSlashing* ~> beaconState
  hint(input %0 %1)

rule ProcessProposerSlashings/fold:
  state proposerSlashing* ~> state_out
  -- (ProcessProposerSlashing: state_cur proposerSlashing ~> state_next)*{
       state -> state_cur ... state_next -> state_out
     }


