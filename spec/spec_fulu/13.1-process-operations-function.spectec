;; [Phase0]
;; process_voluntary_exit
;;  modifies: .VALIDATORS[](.EXIT_EPOCH, .WITHDRAWABLE_EPOCH)

relation ProcessVoluntaryExit:
  beaconState signedVoluntaryExit ~> beaconState
  hint(input %0 %1)

;; [Modified in Electra:EIP7251] no pending withdrawals in the queue
rule ProcessVoluntaryExit/main:
  state signedVoluntaryExit ~> state_exit
  -- if voluntaryExit = signedVoluntaryExit.MESSAGE
  -- if voluntaryExit.VALIDATOR_INDEX = vid_exit
  ;; inserted guard
  -- if $(vid_exit < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid_exit] = validator
  -- if $get_current_epoch(state) = epoch_cur
  ;; assert 1: verify the validator is active
  -- if $is_active_validator(validator, epoch_cur) = true
  ;; assert 2: verify exit has not been initiated
  -- if validator.EXIT_EPOCH = $FAR_FUTURE_EPOCH
  ;; assert 3: exits must specify an epoch when they become valid
  -- if $(epoch_cur >= voluntaryExit.EPOCH)
  ;; assert 4: verify the validator has been active long enough
