;; [Custom | loop : process_attestation] [Electra:EIP7549]
;;  checks each committee of committee_bits and returns the final committee_offset
dec $attestation_committee_offset(beaconState, attestationData, committeeIndex*, boolean*, nat) : nat

def $attestation_committee_offset(state, attestationData, eps, bit*, n_offset) = n_offset

def $attestation_committee_offset(state, attestationData, committeeIndex_h :: committeeIndex_t*, bit*, n_offset)
  = $attestation_committee_offset(state, attestationData, committeeIndex_t*, bit*, $(n_offset + |vid_committee*|))
  ;; assert
  -- if $(committeeIndex_h < $get_committee_count_per_slot(state, attestationData.TARGET.EPOCH))
  -- if $get_beacon_committee(state, attestationData.SLOT, committeeIndex_h) = vid_committee*
  -- if $committee_attesters(vid_committee*, bit*, n_offset) = vid_attesting*
  ;; assert
  -- if $(|vid_attesting*| > 0)

;; [Phase0 -> Altair -> Electra]
;; process_attestation
;;  modifies: .CURRENT_EPOCH_PARTICIPATION / .PREVIOUS_EPOCH_PARTICIPATION, .BALANCES

relation ProcessAttestation:
  beaconState attestation ~> beaconState
  hint(input %0 %1)

;; [Modified in Electra:EIP7549]
rule ProcessAttestation/current_epoch:
  state attestation ~> state_out
  -- if attestationData = attestation.DATA
  ----
  ;; branch instead of assert 1
  -- if attestationData.TARGET.EPOCH = $get_current_epoch(state)
  ;; assert 2
  -- if attestationData.TARGET.EPOCH = $compute_epoch_at_slot(attestationData.SLOT)
  ;; assert 3
  -- if $( attestationData.SLOT + $MIN_ATTESTATION_INCLUSION_DELAY <= state.SLOT )
  ;; Removed in [Deneb]
  ;; -- if $( state.SLOT <= attestationData.SLOT + $SLOTS_PER_EPOCH )
  ;; [Modified in Electra:EIP7549] assert 4: committees from committee_bits
  -- if attestationData.INDEX = 0
  -- if $get_committee_indices(attestation.COMMITTEE_BITS) = committeeIndex*
  -- if $attestation_committee_offset(state, attestationData, committeeIndex*, attestation.AGGREGATION_BITS, 0) = n_offset
  ;; assert 5: Bitfield length matches total number of participants
  -- if |attestation.AGGREGATION_BITS| = n_offset
  ;; participation flag indices
  -- if $get_attestation_participation_flag_indices(state, attestationData, $(state.SLOT - attestationData.SLOT)) = vid_participation_flag*
  ;; assert 6: verify signature
  -- if $is_valid_indexed_attestation(state, $get_indexed_attestation(state, attestation))
  ----
  ;; double loop
  -- ProcessFlags_over_attesting:
      state.CURRENT_EPOCH_PARTICIPATION `[ $get_attesting_indices(state, attestation) `] '++' `{ vid_participation_flag* `}
        '#' state '#' SUM 0
      ~> participationFlags_updated* '#' SUM reward_proposer_numerator
  -- if state[.CURRENT_EPOCH_PARTICIPATION = participationFlags_updated*] = state_1
  -- if $( ($WEIGHT_DENOMINATOR - $PROPOSER_WEIGHT) * $WEIGHT_DENOMINATOR / $PROPOSER_WEIGHT )
      = reward_proposer_denominator
  -- if $(reward_proposer_numerator / reward_proposer_denominator) = reward_proposer
  -- IncreaseBalance: state_1 '.' BALANCES `[ $get_beacon_proposer_index(state_1) `] '+' reward_proposer ~> state_out

rule ProcessAttestation/previous_epoch:
  state attestation ~> state_out
  -- if attestationData = attestation.DATA
  ----
  ;; branch instead of assert 1
  -- if attestationData.TARGET.EPOCH = $get_previous_epoch(state)
  ;; assert 2
  -- if attestationData.TARGET.EPOCH = $compute_epoch_at_slot(attestationData.SLOT)
  ;; assert 3
  -- if $( attestationData.SLOT + $MIN_ATTESTATION_INCLUSION_DELAY <= state.SLOT )
  ;; Removed in [Deneb]
  ;; -- if $( state.SLOT <= attestationData.SLOT + $SLOTS_PER_EPOCH )
  ;; [Modified in Electra:EIP7549] assert 4: committees from committee_bits
  -- if attestationData.INDEX = 0
  -- if $get_committee_indices(attestation.COMMITTEE_BITS) = committeeIndex*
  -- if $attestation_committee_offset(state, attestationData, committeeIndex*, attestation.AGGREGATION_BITS, 0) = n_offset
  ;; assert 5: Bitfield length matches total number of participants
  -- if |attestation.AGGREGATION_BITS| = n_offset
  ;; participation flag indices
  -- if $get_attestation_participation_flag_indices(state, attestationData, $(state.SLOT - attestationData.SLOT)) = vid_participation_flag*
  ;; assert 6: verify signature
  -- if $is_valid_indexed_attestation(state, $get_indexed_attestation(state, attestation))
  ----
  ;; double loop
  -- ProcessFlags_over_attesting:
      state.PREVIOUS_EPOCH_PARTICIPATION `[ $get_attesting_indices(state, attestation) `] '++' `{ vid_participation_flag* `}
        '#' state '#' SUM 0
      ~> participationFlags_updated* '#' SUM reward_proposer_numerator
  -- if state[.PREVIOUS_EPOCH_PARTICIPATION = participationFlags_updated*] = state_1
  -- if $( ($WEIGHT_DENOMINATOR - $PROPOSER_WEIGHT) * $WEIGHT_DENOMINATOR / $PROPOSER_WEIGHT )
      = reward_proposer_denominator
  -- if $(reward_proposer_numerator / reward_proposer_denominator) = reward_proposer
  -- IncreaseBalance: state_1 '.' BALANCES `[ $get_beacon_proposer_index(state_1) `] '+' reward_proposer ~> state_out

;; fold ProcessAttestation over attestation*
relation ProcessAttestations:
  beaconState attestation* ~> beaconState
  hint(input %0 %1)

rule ProcessAttestations/fold:
  state attestation* ~> state_out
  -- (ProcessAttestation: state_cur attestation ~> state_next)*{
       state -> state_cur ... state_next -> state_out
     }


