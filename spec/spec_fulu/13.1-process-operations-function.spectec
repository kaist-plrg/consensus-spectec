;; [Electra:EIP6110]
;; process_deposit_request
;;  modifies: PENDING_DEPOSITS

relation ProcessDepositRequest:
  beaconState DEPOSIT_REQUEST depositRequest ~> beaconState
  hint(input %0 %1)

;; [Modified in Fulu] DEPOSIT_REQUESTS_START_INDEX is no longer set
rule ProcessDepositRequest:
  state DEPOSIT_REQUEST depositRequest
  ~> state[.PENDING_DEPOSITS = state.PENDING_DEPOSITS ++ [pendingDeposit]]
  -- if pendingDeposit = { PUBKEY depositRequest.PUBKEY,
                           WITHDRAWAL_CREDENTIALS depositRequest.WITHDRAWAL_CREDENTIALS,
                           AMOUNT depositRequest.AMOUNT,
                           SIGNATURE depositRequest.SIGNATURE,
                           SLOT state.SLOT }

;; fold ProcessDepositRequest over depositRequest*
relation ProcessDepositRequests:
  beaconState depositRequest* ~> beaconState
  hint(input %0 %1)

rule ProcessDepositRequests/fold:
  state depositRequest* ~> state_out
  -- (ProcessDepositRequest: state_cur DEPOSIT_REQUEST depositRequest ~> state_next)*{
       state -> state_cur ... state_next -> state_out
     }


;; [Electra:EIP7002:EIP7251]
;; process_withdrawal_request
;;  modifies: PENDING_PARTIAL_WITHDRAWALS, EXIT_BALANCE_TO_CONSUME, EARLIEST_EXIT_EPOCH,
;;    VALIDATORS[](.EXIT_EPOCH, .WITHDRAWABLE_EPOCH)

;; [Custom | branch : process_withdrawal_request] all the `return`s before the pending balance
dec $is_valid_withdrawal_request(beaconState, withdrawalRequest) : boolean
def $is_valid_withdrawal_request(state, withdrawalRequest) = true
  ;; If partial withdrawal queue is full, only full exits are processed
  -- if ~( $(|state.PENDING_PARTIAL_WITHDRAWALS| = $PENDING_PARTIAL_WITHDRAWALS_LIMIT)
          /\ withdrawalRequest.AMOUNT =/= $FULL_EXIT_REQUEST_AMOUNT )
  ;; Verify pubkey exists
  -- if $validator_pubkeys(state) = blsPubkey*
  -- if ( withdrawalRequest.VALIDATOR_PUBKEY <- blsPubkey* )
  -- if state.VALIDATORS[$index_of_<blsPubkey>(blsPubkey*, withdrawalRequest.VALIDATOR_PUBKEY)] = validator
  ;; Verify withdrawal credentials
  -- if $has_execution_withdrawal_credential(validator) = true
  -- if $extract_execution_address(validator.WITHDRAWAL_CREDENTIALS) = withdrawalRequest.SOURCE_ADDRESS
  ;; Verify the validator is active
  -- if $get_current_epoch(state) = epoch_cur
  -- if $is_active_validator(validator, epoch_cur) = true
  ;; Verify exit has not been initiated
  -- if validator.EXIT_EPOCH = $FAR_FUTURE_EPOCH
  ;; Verify the validator has been active long enough
  -- if $(epoch_cur >= validator.ACTIVATION_EPOCH + $SHARD_COMMITTEE_PERIOD)
def $is_valid_withdrawal_request(state, withdrawalRequest) = false
  -- otherwise

;; [Custom | branch : process_withdrawal_request] the partial withdrawal conditions
dec $is_valid_partial_withdrawal(validator, gwei, gwei) : boolean
def $is_valid_partial_withdrawal(validator, balance, gwei_pending) = true
  ;; Only allow partial withdrawals with compounding withdrawal credentials
  -- if $has_compounding_withdrawal_credential(validator) = true
  -- if $(validator.EFFECTIVE_BALANCE >= $MIN_ACTIVATION_BALANCE)
  -- if $(balance > $MIN_ACTIVATION_BALANCE + gwei_pending)
def $is_valid_partial_withdrawal(validator, balance, gwei_pending) = false
  -- otherwise

relation ProcessWithdrawalRequest:
  beaconState WITHDRAWAL_REQUEST withdrawalRequest ~> beaconState
  hint(input %0 %1)

rule ProcessWithdrawalRequest/ignored:
  state WITHDRAWAL_REQUEST withdrawalRequest ~> state
  -- if $is_valid_withdrawal_request(state, withdrawalRequest) = false

;; full exit with no pending withdrawals in the queue
rule ProcessWithdrawalRequest/full_exit:
  state WITHDRAWAL_REQUEST withdrawalRequest ~> state_out
  -- if $is_valid_withdrawal_request(state, withdrawalRequest) = true
  -- if withdrawalRequest.AMOUNT = $FULL_EXIT_REQUEST_AMOUNT
  -- if $index_of_<blsPubkey>($validator_pubkeys(state), withdrawalRequest.VALIDATOR_PUBKEY) = vid
  -- if $get_pending_balance_to_withdraw(state, vid) = 0
  -- InitiateValidatorExit: state '.' VALIDATORS `[ vid `] ~> state_out

;; full exit with pending withdrawals: return
rule ProcessWithdrawalRequest/full_exit_pending:
  state WITHDRAWAL_REQUEST withdrawalRequest ~> state
  -- if $is_valid_withdrawal_request(state, withdrawalRequest) = true
  -- if withdrawalRequest.AMOUNT = $FULL_EXIT_REQUEST_AMOUNT
  -- if $index_of_<blsPubkey>($validator_pubkeys(state), withdrawalRequest.VALIDATOR_PUBKEY) = vid
  -- if $($get_pending_balance_to_withdraw(state, vid) > 0)

;; partial withdrawal: queue it behind the exit churn
rule ProcessWithdrawalRequest/partial:
  state WITHDRAWAL_REQUEST withdrawalRequest
  ~> state_churn[.PENDING_PARTIAL_WITHDRAWALS = state_churn.PENDING_PARTIAL_WITHDRAWALS ++ [pendingPartialWithdrawal]]
  -- if $is_valid_withdrawal_request(state, withdrawalRequest) = true
  -- if withdrawalRequest.AMOUNT =/= $FULL_EXIT_REQUEST_AMOUNT
  -- if $index_of_<blsPubkey>($validator_pubkeys(state), withdrawalRequest.VALIDATOR_PUBKEY) = vid
  -- if state.VALIDATORS[vid] = validator
  ;; inserted guard (python raises IndexError)
  -- if $(vid < |state.BALANCES|)
  -- if state.BALANCES[vid] = balance
  -- if $get_pending_balance_to_withdraw(state, vid) = gwei_pending
  -- if $is_valid_partial_withdrawal(validator, balance, gwei_pending) = true
  -- if $min_uint64($(balance - $MIN_ACTIVATION_BALANCE - gwei_pending), withdrawalRequest.AMOUNT) = gwei_to_withdraw
  -- ComputeExitEpochAndUpdateChurn: state EXIT_CHURN gwei_to_withdraw ~> state_churn
  ;; inserted overflow check
  -- if $(state_churn.EARLIEST_EXIT_EPOCH <= $UINT64_MAX - $MIN_VALIDATOR_WITHDRAWABILITY_DELAY)
  -- if pendingPartialWithdrawal =
       { VALIDATOR_INDEX vid,
         AMOUNT gwei_to_withdraw,
         WITHDRAWABLE_EPOCH $(state_churn.EARLIEST_EXIT_EPOCH + $MIN_VALIDATOR_WITHDRAWABILITY_DELAY) }

;; partial withdrawal that does not qualify: return
rule ProcessWithdrawalRequest/partial_ignored:
  state WITHDRAWAL_REQUEST withdrawalRequest ~> state
  -- if $is_valid_withdrawal_request(state, withdrawalRequest) = true
  -- if withdrawalRequest.AMOUNT =/= $FULL_EXIT_REQUEST_AMOUNT
  -- if $index_of_<blsPubkey>($validator_pubkeys(state), withdrawalRequest.VALIDATOR_PUBKEY) = vid
  -- if state.VALIDATORS[vid] = validator
  -- if $(vid < |state.BALANCES|)
  -- if $is_valid_partial_withdrawal(validator, state.BALANCES[vid], $get_pending_balance_to_withdraw(state, vid)) = false

;; fold ProcessWithdrawalRequest over withdrawalRequest*
relation ProcessWithdrawalRequests:
  beaconState withdrawalRequest* ~> beaconState
  hint(input %0 %1)

rule ProcessWithdrawalRequests/fold:
  state withdrawalRequest* ~> state_out
  -- (ProcessWithdrawalRequest: state_cur WITHDRAWAL_REQUEST withdrawalRequest ~> state_next)*{
       state -> state_cur ... state_next -> state_out
     }


;; [Electra:EIP7251]
;; process_consolidation_request
;;  modifies: VALIDATORS, BALANCES, PENDING_DEPOSITS (switch to compounding),
;;    CONSOLIDATION_BALANCE_TO_CONSUME, EARLIEST_CONSOLIDATION_EPOCH, PENDING_CONSOLIDATIONS

;; [Electra] is_valid_switch_to_compounding_request(BeaconState, ConsolidationRequest) -> bool
;;  the early `return False`s become one conjunction
dec $is_valid_switch_to_compounding_request(beaconState, consolidationRequest) : boolean
def $is_valid_switch_to_compounding_request(state, consolidationRequest) = true
  ;; Switch to compounding requires source and target be equal
  -- if consolidationRequest.SOURCE_PUBKEY = consolidationRequest.TARGET_PUBKEY
  ;; Verify pubkey exists
  -- if $validator_pubkeys(state) = blsPubkey*
  -- if ( consolidationRequest.SOURCE_PUBKEY <- blsPubkey* )
  -- if state.VALIDATORS[$index_of_<blsPubkey>(blsPubkey*, consolidationRequest.SOURCE_PUBKEY)] = validator
  ;; Verify request has been authorized
  -- if $extract_execution_address(validator.WITHDRAWAL_CREDENTIALS) = consolidationRequest.SOURCE_ADDRESS
  ;; Verify source withdrawal credentials
  -- if $has_eth1_withdrawal_credential(validator) = true
  ;; Verify the source is active
  -- if $is_active_validator(validator, $get_current_epoch(state)) = true
  ;; Verify exit for source has not been initiated
  -- if validator.EXIT_EPOCH = $FAR_FUTURE_EPOCH
def $is_valid_switch_to_compounding_request(state, consolidationRequest) = false
  -- otherwise

;; [Custom | branch : process_consolidation_request] all the `return`s of the consolidation path
dec $is_valid_consolidation_request(beaconState, consolidationRequest) : boolean
def $is_valid_consolidation_request(state, consolidationRequest) = true
  ;; Verify that source != target, so a consolidation cannot be used as an exit
  -- if consolidationRequest.SOURCE_PUBKEY =/= consolidationRequest.TARGET_PUBKEY
  ;; If the pending consolidations queue is full, consolidation requests are ignored
  -- if $(|state.PENDING_CONSOLIDATIONS| < $PENDING_CONSOLIDATIONS_LIMIT)
  ;; If there is too little available consolidation churn limit, consolidation requests are ignored
  -- if $($get_consolidation_churn_limit(state) > $MIN_ACTIVATION_BALANCE)
  ;; Verify pubkeys exists
  -- if $validator_pubkeys(state) = blsPubkey*
  -- if ( consolidationRequest.SOURCE_PUBKEY <- blsPubkey* )
  -- if ( consolidationRequest.TARGET_PUBKEY <- blsPubkey* )
  -- if state.VALIDATORS[$index_of_<blsPubkey>(blsPubkey*, consolidationRequest.SOURCE_PUBKEY)] = validator_source
  -- if state.VALIDATORS[$index_of_<blsPubkey>(blsPubkey*, consolidationRequest.TARGET_PUBKEY)] = validator_target
  ;; Verify source withdrawal credentials
  -- if $has_execution_withdrawal_credential(validator_source) = true
  -- if $extract_execution_address(validator_source.WITHDRAWAL_CREDENTIALS) = consolidationRequest.SOURCE_ADDRESS
  ;; Verify that target has compounding withdrawal credentials
  -- if $has_compounding_withdrawal_credential(validator_target) = true
  ;; Verify the source and the target are active
  -- if $get_current_epoch(state) = epoch_cur
  -- if $is_active_validator(validator_source, epoch_cur) = true
  -- if $is_active_validator(validator_target, epoch_cur) = true
  ;; Verify exits for source and target have not been initiated
  -- if validator_source.EXIT_EPOCH = $FAR_FUTURE_EPOCH
  -- if validator_target.EXIT_EPOCH = $FAR_FUTURE_EPOCH
  ;; Verify the source has been active long enough
  -- if $(epoch_cur >= validator_source.ACTIVATION_EPOCH + $SHARD_COMMITTEE_PERIOD)
  ;; Verify the source has no pending withdrawals in the queue
  -- if $get_pending_balance_to_withdraw(state, $index_of_<blsPubkey>(blsPubkey*, consolidationRequest.SOURCE_PUBKEY)) = 0
def $is_valid_consolidation_request(state, consolidationRequest) = false
  -- otherwise

relation ProcessConsolidationRequest:
  beaconState CONSOLIDATION_REQUEST consolidationRequest ~> beaconState
  hint(input %0 %1)

rule ProcessConsolidationRequest/switch_to_compounding:
  state CONSOLIDATION_REQUEST consolidationRequest ~> state_out
  -- if $is_valid_switch_to_compounding_request(state, consolidationRequest) = true
  -- if $index_of_<blsPubkey>($validator_pubkeys(state), consolidationRequest.SOURCE_PUBKEY) = vid_source
  -- SwitchToCompoundingValidator: state SWITCH_TO_COMPOUNDING vid_source ~> state_out

rule ProcessConsolidationRequest/ignored:
  state CONSOLIDATION_REQUEST consolidationRequest ~> state
  -- if $is_valid_switch_to_compounding_request(state, consolidationRequest) = false
  -- if $is_valid_consolidation_request(state, consolidationRequest) = false

;; Initiate source validator exit and append pending consolidation
rule ProcessConsolidationRequest/consolidate:
  state CONSOLIDATION_REQUEST consolidationRequest
  ~> state_churn[.VALIDATORS[vid_source] = validator_source[.EXIT_EPOCH = epoch_exit]
                                                           [.WITHDRAWABLE_EPOCH = $(epoch_exit + $MIN_VALIDATOR_WITHDRAWABILITY_DELAY)]]
                [.PENDING_CONSOLIDATIONS = state_churn.PENDING_CONSOLIDATIONS ++ [pendingConsolidation]]
  -- if $is_valid_switch_to_compounding_request(state, consolidationRequest) = false
  -- if $is_valid_consolidation_request(state, consolidationRequest) = true
  -- if $validator_pubkeys(state) = blsPubkey*
  -- if $index_of_<blsPubkey>(blsPubkey*, consolidationRequest.SOURCE_PUBKEY) = vid_source
  -- if $index_of_<blsPubkey>(blsPubkey*, consolidationRequest.TARGET_PUBKEY) = vid_target
  -- ComputeConsolidationEpochAndUpdateChurn:
       state CONSOLIDATION_CHURN state.VALIDATORS[vid_source].EFFECTIVE_BALANCE ~> state_churn
  -- if state_churn.EARLIEST_CONSOLIDATION_EPOCH = epoch_exit
  -- if state_churn.VALIDATORS[vid_source] = validator_source
  ;; inserted overflow check
  -- if $(epoch_exit <= $UINT64_MAX - $MIN_VALIDATOR_WITHDRAWABILITY_DELAY)
  -- if pendingConsolidation = { SOURCE_INDEX vid_source, TARGET_INDEX vid_target }

;; fold ProcessConsolidationRequest over consolidationRequest*
relation ProcessConsolidationRequests:
  beaconState consolidationRequest* ~> beaconState
  hint(input %0 %1)

rule ProcessConsolidationRequests/fold:
  state consolidationRequest* ~> state_out
  -- (ProcessConsolidationRequest: state_cur CONSOLIDATION_REQUEST consolidationRequest ~> state_next)*{
       state -> state_cur ... state_next -> state_out
     }
