  ;; verify signature
  ;; modified in [Deneb]
  -- if $compute_domain($DOMAIN_VOLUNTARY_EXIT, $CAPELLA_FORK_VERSION, state.GENESIS_VALIDATORS_ROOT) = domain_exit
  -- if $compute_signing_root_voluntary_exit(voluntaryExit, domain_exit) = root_vol_exit_signing_root
