;; [Modified in Electra:EIP6110] Disable former deposit mechanism once all prior deposits are processed
;; [Altair]
;; process_sync_aggregate

relation ProcessSyncAggregate:
  beaconState syncAggregate ~> beaconState
  hint(input %0 %1)

rule ProcessSyncAggregate:
  state syncAggregate ~> state_updated
  ;; get participants (committee /\ bits == true)
  ;; use simplified logic instead of the optimized version in the spec
  -- if blsPubkey_committee* = state.CURRENT_SYNC_COMMITTEE.PUBKEYS
  -- if $enumerate_<blsPubkey>(blsPubkey_committee*) = (i_committee, blsPubkey_committee)*
  -- if $filter_list_2_<(nat, blsPubkey), boolean*>(
        (i_committee, blsPubkey_committee)*,
        syncAggregate.SYNC_COMMITTEE_BITS,
        def $bit_is_one_en_blsPubkey
      ) = (_, blsPubkey_participants)*
  ;; helper instead of branching
  -- if $get_prev_slot(state.SLOT) = slot_prev
  -- if $get_domain(state, $DOMAIN_SYNC_COMMITTEE, $compute_epoch_at_slot(slot_prev)) = domain
  -- if $compute_signing_root_block_root($get_block_root_at_slot(state, slot_prev), domain) = root_sign
  ;; assert 1: fast aggregate verify allows empty participants
  -- if $eth_fast_aggregate_verify(
         blsPubkey_participants*,
         root_sign,
         syncAggregate.SYNC_COMMITTEE_SIGNATURE
       )
  ;; Compute participant and proposer rewards
  -- if $( $get_total_active_balance(state) / $EFFECTIVE_BALANCE_INCREMENT ) = uint64_total_incs
  -- if $( $get_base_reward_per_increment(state) * uint64_total_incs ) = reward_total_base
  -- if $( reward_total_base * $SYNC_REWARD_WEIGHT / $WEIGHT_DENOMINATOR / $SLOTS_PER_EPOCH ) = reward_max_participant
  -- if $( reward_max_participant / $SYNC_COMMITTEE_SIZE ) = reward_participant
  -- if $( reward_participant * $PROPOSER_WEIGHT / ( $WEIGHT_DENOMINATOR - $PROPOSER_WEIGHT )) = reward_proposer
  ;; Apply participant and proposer rewards
  -- if $enumerate_<validator>(state.VALIDATORS) = (vid, validator)*
  -- if (validator.PUBKEY = blsPubkey_existing)*
  -- if state.CURRENT_SYNC_COMMITTEE.PUBKEYS = blsPubkey_committee*
  -- if ($index_of_pubkey((vid, blsPubkey_existing)*, blsPubkey_committee) = vid_committee)*
  -- if syncAggregate.SYNC_COMMITTEE_BITS = boolean_participation*
  -- if $get_beacon_proposer_index(state) = vid_proposer
  -- ApplyReward_over_participants:
      state
        PARTICIPANT boolean_participation* `[vid_committee*`] '+' reward_participant
        PROPOSER `[ vid_proposer `] '+' reward_proposer
          ~> state_updated
