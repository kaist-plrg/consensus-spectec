;; [Phase0]
;; process_randao
;;  mutates: RANDAO_MIXES[epoch \ EPOCHS_PER_HISTORICAL_VECTOR]

relation ProcessRandao:
  beaconState beaconBlockBody ~> beaconState
  hint(input %0 %1)

rule ProcessRandao:
  state body ~> state[.RANDAO_MIXES[uint64_n] = bytes32_mix_new]
  -- if $get_current_epoch(state) = epoch
  -- if $get_beacon_proposer_index(state) = vid_proposer
  ;; inserted: bound check
  -- if $(vid_proposer < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid_proposer] = validator_proposer
  -- if $get_domain(state, $DOMAIN_RANDAO, eps) = domain_randao
  -- if $compute_signing_root_epoch(epoch, domain_randao) = root_signing
  ;; assert 1: verify RANDAO_REVEAL
  -- if $bls_verify(validator_proposer.PUBKEY, root_signing, body.RANDAO_REVEAL)
  -- if $get_randao_mix(state, epoch) = bytes32_mix_old
  -- if $hash_<blsSignature>(body.RANDAO_REVEAL) = bytes32_hash_reveal
  -- if $xor(bytes32_mix_old, bytes32_hash_reveal) = bytes32_mix_new
  -- if $(epoch \ $EPOCHS_PER_HISTORICAL_VECTOR) = uint64_n

;; [Phase0]
;; process_eth1_data
;;  mutates: ETH1_DATA, ETH1_DATA_VOTES (append)

relation ProcessEth1Data:
  beaconState beaconBlockBody ~> beaconState
  hint(input %0 %1)

rule ProcessEth1Data/majority:
  state body ~> (state[.ETH1_DATA_VOTES = eth1Data_update*][.ETH1_DATA = body.ETH1_DATA])
  -- if state.ETH1_DATA_VOTES ++ [ body.ETH1_DATA ] = eth1Data_update*
  -- if $count_occurrences_<eth1Data>(eth1Data_update*, body.ETH1_DATA) = n_occ
  ;; branch-complete
  -- if $(n_occ * 2 > $EPOCHS_PER_ETH1_VOTING_PERIOD * $SLOTS_PER_EPOCH)

rule ProcessEth1Data/accumulate:
  state body ~> state[.ETH1_DATA_VOTES = eth1Data_update*]
  -- if state.ETH1_DATA_VOTES ++ [ body.ETH1_DATA ] = eth1Data_update*
  -- if $count_occurrences_<eth1Data>(eth1Data_update*, body.ETH1_DATA) = n_occ
  ;; branch-complete
  -- if $(n_occ * 2 <= $EPOCHS_PER_ETH1_VOTING_PERIOD * $SLOTS_PER_EPOCH)

;; [Custom | branch : process_operations] [Electra:EIP6110]
;;  the number of Eth1 bridge deposits a block must hold
dec $expected_deposit_count(beaconState) : nat
def $expected_deposit_count(state) = $min_uint64($MAX_DEPOSITS, $(uint64_limit - state.ETH1_DEPOSIT_INDEX))
  -- if $min_uint64(state.ETH1_DATA.DEPOSIT_COUNT, state.DEPOSIT_REQUESTS_START_INDEX) = uint64_limit
  -- if $(state.ETH1_DEPOSIT_INDEX < uint64_limit)
def $expected_deposit_count(state) = 0
  -- otherwise

