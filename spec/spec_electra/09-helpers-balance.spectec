;; =========================
;; helpers for Increase / Decrease / initiate_validator_exit / slash_validator / apply_deposit 
;; =========================

;; [Phase0]
;; increase_balance(beaconState, validatorIndex, gwei) : beaconState
;;  mutates: .BALANCES

relation IncreaseBalance:
  beaconState '.' BALANCES `[ validatorIndex `] '+' gwei ~> beaconState
  hint(input %0 %1 %2)

rule IncreaseBalance:
  state '.' BALANCES `[ vid `] '+' delta ~> state[ .BALANCES[vid] = $(balance + delta) ]
  -- if $(vid < |state.BALANCES|)
  -- if state.BALANCES[vid] = balance
  ;; inserted overflow check
  -- if $(balance <= $UINT64_MAX - delta)

;; [Phase0]
;; decrease_balance(beaconState, validatorIndex, gwei) : beaconState
;;  mutates: .BALANCES

relation DecreaseBalance:
  beaconState '.' BALANCES  `[ validatorIndex `] '-' gwei ~> beaconState
  hint(input %0 %1 %2)

rule DecreaseBalance/zero:
  state '.' BALANCES `[ vid `] '-' delta ~> state[ .BALANCES[vid] = 0]
  -- if $(vid < |state.BALANCES|)
  -- if state.BALANCES[vid] = balance
  ;; branch
  -- if $(delta > balance)
  
rule DecreaseBalance/remains:
  state '.' BALANCES `[ vid `] '-' delta ~> state[ .BALANCES[vid] = $(balance - delta) ]
  -- if $(vid < |state.BALANCES|)
  -- if state.BALANCES[vid] = balance
  ;; branch
  -- if $(delta <= balance)

;; ----------------------------
;; helpers for exit-epoch lists
;; ----------------------------
dec $exit_epoch_not_far_future(validator) : boolean
def $exit_epoch_not_far_future(validator) = true
  -- if validator.EXIT_EPOCH =/= $FAR_FUTURE_EPOCH
def $exit_epoch_not_far_future(validator) = false
  -- otherwise

dec $exit_epoch_eq(validator, epoch) : boolean
def $exit_epoch_eq(validator, epoch) = true
  -- if validator.EXIT_EPOCH = epoch
def $exit_epoch_eq(validator, epoch) = false
  -- otherwise

;; helper: churn >= limit -> epoch + 1, else epoch
dec $select_epoch_exit_queue(epoch, uint64, uint64) : epoch
def $select_epoch_exit_queue(epoch_exit_queue_0, uint64_churn, uint64_limit)
  = $( epoch_exit_queue_0 + 1 )
  -- if $( uint64_churn >= uint64_limit )
def $select_epoch_exit_queue(epoch_exit_queue_0, uint64_churn, uint64_limit)
  = epoch_exit_queue_0
  -- otherwise

