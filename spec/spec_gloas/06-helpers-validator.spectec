;; ================================
;; validator predicates & helpers
;; ================================

;; [Phase0] compute_activation_exit_epoch(Epoch) -> Epoch
dec $compute_activation_exit_epoch(epoch) : epoch
def $compute_activation_exit_epoch(epoch) = $(epoch + 1 + $MAX_SEED_LOOKAHEAD)

;; [Phase0] is_active_validator(Validator, Epoch) -> bool
dec $is_active_validator(validator, epoch) : boolean

def $is_active_validator(validator, epoch) = true
  -- if $(validator.ACTIVATION_EPOCH <= epoch)
  -- if $(epoch < validator.EXIT_EPOCH)

def $is_active_validator(validator, epoch) = false
  -- otherwise

;; [Phase0] is_eligible_for_activation_queue(Validator) -> bool
dec $is_eligible_for_activation_queue(validator) : boolean

;; [Modified in Electra:EIP7251] MIN_ACTIVATION_BALANCE instead of MAX_EFFECTIVE_BALANCE
def $is_eligible_for_activation_queue(validator) = true
  -- if validator.ACTIVATION_ELIGIBILITY_EPOCH = $FAR_FUTURE_EPOCH
  -- if $(validator.EFFECTIVE_BALANCE >= $MIN_ACTIVATION_BALANCE)

def $is_eligible_for_activation_queue(validator) = false
  -- otherwise

;; [Phase0] is_eligible_for_activation(BeaconState, Validator) -> bool
dec $is_eligible_for_activation(beaconState, validator) : boolean

def $is_eligible_for_activation(state, validator) = true
  -- if $(validator.ACTIVATION_ELIGIBILITY_EPOCH <= state.FINALIZED_CHECKPOINT.EPOCH)
  -- if validator.ACTIVATION_EPOCH = $FAR_FUTURE_EPOCH

def $is_eligible_for_activation(state, validator) = false
  -- otherwise

;; [Phase0] is_slashable_validator(Validator, Epoch) -> bool
dec $is_slashable_validator(validator, epoch) : boolean

def $is_slashable_validator(validator, epoch) = true
  -- if ~ validator.SLASHED
  -- if $(validator.ACTIVATION_EPOCH <= epoch)
  -- if $(epoch < validator.WITHDRAWABLE_EPOCH)

def $is_slashable_validator(validator, epoch) = false
  -- otherwise

;; [Capella] has_eth1_withdrawal_credential(Validator) -> bool
dec $has_eth1_withdrawal_credential(validator) : boolean

def $has_eth1_withdrawal_credential(validator) = ($get_first_byte(validator.WITHDRAWAL_CREDENTIALS) = $ETH1_ADDRESS_WITHDRAWAL_PREFIX)

;; [Electra] is_compounding_withdrawal_credential(Bytes32) -> bool
dec $is_compounding_withdrawal_credential(bytes32) : boolean

def $is_compounding_withdrawal_credential(bytes32_wc) = ($get_first_byte(bytes32_wc) = $COMPOUNDING_WITHDRAWAL_PREFIX)

;; [Electra] has_compounding_withdrawal_credential(Validator) -> bool
dec $has_compounding_withdrawal_credential(validator) : boolean

def $has_compounding_withdrawal_credential(validator) = $is_compounding_withdrawal_credential(validator.WITHDRAWAL_CREDENTIALS)

;; [Electra] has_execution_withdrawal_credential(Validator) -> bool
;;  0x01 or 0x02 prefix
dec $has_execution_withdrawal_credential(validator) : boolean

def $has_execution_withdrawal_credential(validator)
  = $has_eth1_withdrawal_credential(validator) \/ $has_compounding_withdrawal_credential(validator)

;; [Capella] is_fully_withdrawable_validator(Validator, Gwei, Epoch) -> bool
dec $is_fully_withdrawable_validator(validator, gwei, epoch) : boolean

;; [Modified in Electra:EIP7251] has_execution_withdrawal_credential
def $is_fully_withdrawable_validator(validator, balance, epoch) = true
  -- if $has_execution_withdrawal_credential(validator) = true
  -- if $(validator.WITHDRAWABLE_EPOCH <= epoch)
  -- if $(balance > 0)

def $is_fully_withdrawable_validator(validator, balance, epoch) = false
  -- otherwise

;; [Electra] get_max_effective_balance(Validator) -> Gwei
dec $get_max_effective_balance(validator) : gwei

def $get_max_effective_balance(validator) = $MAX_EFFECTIVE_BALANCE_ELECTRA
  -- if $has_compounding_withdrawal_credential(validator) = true

def $get_max_effective_balance(validator) = $MIN_ACTIVATION_BALANCE
  -- otherwise

;; [Capella] is_partially_withdrawable_validator(Validator, Gwei) -> bool
dec $is_partially_withdrawable_validator(validator, gwei) : boolean

;; [Modified in Electra:EIP7251] get_max_effective_balance, has_execution_withdrawal_credential
def $is_partially_withdrawable_validator(validator, balance) = true
  -- if $has_execution_withdrawal_credential(validator) = true
  -- if $get_max_effective_balance(validator) = balance_max
  -- if $(validator.EFFECTIVE_BALANCE = balance_max)
  -- if $(balance > balance_max)

def $is_partially_withdrawable_validator(validator, balance) = false
  -- otherwise

;; [Electra] is_eligible_for_partial_withdrawals(Validator, Gwei) -> bool
dec $is_eligible_for_partial_withdrawals(validator, gwei) : boolean

def $is_eligible_for_partial_withdrawals(validator, balance) = true
  -- if validator.EXIT_EPOCH = $FAR_FUTURE_EPOCH
  -- if $(validator.EFFECTIVE_BALANCE >= $MIN_ACTIVATION_BALANCE)
  -- if $(balance > $MIN_ACTIVATION_BALANCE)

def $is_eligible_for_partial_withdrawals(validator, balance) = false
  -- otherwise


;; [Custom]
dec $is_active_validator_enumerated(enumerated_<validator>, epoch) : bool
def $is_active_validator_enumerated((_, validator), epoch) = $is_active_validator(validator, epoch)

;; [Altair] get_active_validator_indices(BeaconState, Epoch) : ValidatorIndex*
dec $get_active_validator_indices(beaconState, epoch) : validatorIndex*
def $get_active_validator_indices(state, epoch) = vid_active*
  -- if $enumerate_<validator>(state.VALIDATORS) = (vid, validator)*
  -- if $filter_list_2_<(validatorIndex, validator), epoch>(
      (vid, validator)*,
      epoch,
      def $is_active_validator_enumerated
    )
    = (vid_active, _)*

;; [Custom | Electra] validator_pubkeys = [v.pubkey for v in state.validators]
dec $validator_pubkeys(beaconState) : blsPubkey*
def $validator_pubkeys(state) = blsPubkey*
  -- if state.VALIDATORS = validator*
  -- if (validator.PUBKEY = blsPubkey)*

;; [Phase0] get_validator_churn_limit(BeaconState) -> uint64
dec $get_validator_churn_limit(beaconState) : uint64
def $get_validator_churn_limit(state)
  = $max_uint64($MIN_PER_EPOCH_CHURN_LIMIT, $(|vid_active*| / $CHURN_LIMIT_QUOTIENT))
  -- if $get_active_validator_indices(state, $get_current_epoch(state)) = vid_active*

;; [Altair] get_index_for_new_validator(BeaconState) : ValidatorIndex
;; dec $get_index_for_new_validator(beaconState) : validatorIndex
;; def $get_index_for_new_validator(state) = |state.VALIDATORS|

;; [Phase0] get_validator_from_deposit(BLSPubkey, Bytes32, uint64) : validator
dec $get_validator_from_deposit(blsPubkey, bytes32, uint64) : validator

;; [Modified in Electra:EIP7251] the cap is get_max_effective_balance of the new validator
def $get_validator_from_deposit(blsPubkey, bytes32_withdrawal, uint64_amount)
  = validator_0[.EFFECTIVE_BALANCE = balance_effective]
  -- if validator_0 = { PUBKEY                       blsPubkey,
                      WITHDRAWAL_CREDENTIALS       bytes32_withdrawal,
                      EFFECTIVE_BALANCE            0,
                      SLASHED                      false,
                      ACTIVATION_ELIGIBILITY_EPOCH $FAR_FUTURE_EPOCH,
                      ACTIVATION_EPOCH             $FAR_FUTURE_EPOCH,
                      EXIT_EPOCH                   $FAR_FUTURE_EPOCH,
                      WITHDRAWABLE_EPOCH           $FAR_FUTURE_EPOCH }
  -- if $min_uint64($(uint64_amount - uint64_amount \ $EFFECTIVE_BALANCE_INCREMENT),
                    $get_max_effective_balance(validator_0)) = balance_effective

;; [Phase0 -> Altair]
;; add_validator_to_registry(state, pubkey, withdrawal_credentials, amount) : beaconState
;;  mutates: VALIDATORS, BALANCES, PREVIOUS_EPOCH_PARTICIPATION, CURRENT_EPOCH_PARTICIPATION, INACTIVITY_SCORES
;; [Modified in Electra:EIP7251] through get_validator_from_deposit only

relation AddValidatorToRegistry:
  beaconState '.' VALIDATORS '++' `{ blsPubkey bytes32 uint64 `} ~> beaconState
  hint(input %0 %1 %2 %3)

rule AddValidatorToRegistry:
  state '.' VALIDATORS '++' `{ blsPubkey bytes32_wc uint64_amount `}
  ~> state [.VALIDATORS = validator_updated*]
          [.BALANCES = balance_updated*]
          [.PREVIOUS_EPOCH_PARTICIPATION = participationFlags_prev_updated*]
          [.CURRENT_EPOCH_PARTICIPATION = participationFlags_cur_updated*]
          [.INACTIVITY_SCORES = uint64_inactivity_updated*]
  ;; inlined: get_index_for_new_validator
  -- if |state.VALIDATORS| = vid_new
  -- if $get_validator_from_deposit(blsPubkey, bytes32_wc, uint64_amount) = validator
  ;; update state
  -- if $set_or_append_list_<validator>(state.VALIDATORS, vid_new, validator) = validator_updated*
  -- if $set_or_append_list_<gwei>(state.BALANCES, vid_new, uint64_amount) = balance_updated*
  -- if $set_or_append_list_<participationFlags>(state.PREVIOUS_EPOCH_PARTICIPATION, vid_new, 0) = participationFlags_prev_updated*
  -- if $set_or_append_list_<participationFlags>(state.CURRENT_EPOCH_PARTICIPATION, vid_new, 0) = participationFlags_cur_updated*
  -- if $set_or_append_list_<uint64>(state.INACTIVITY_SCORES, vid_new, 0) = uint64_inactivity_updated*


;; [Custom | filter helper : get_eligible_validator_indices]
dec $is_eligible_validator_enumerated(enumerated_<validator>, epoch) : bool
def $is_eligible_validator_enumerated((_, validator), epoch_prev) =
  $is_active_validator(validator, epoch_prev)
  \/
  ( validator.SLASHED /\ $(epoch_prev + 1 < validator.WITHDRAWABLE_EPOCH) )

;; [Phase0] get_eligible_validator_indices(BeaconState) -> Sequence[ValidatorIndex]
dec $get_eligible_validator_indices(beaconState) : validatorIndex*

def $get_eligible_validator_indices(state) = vid_eligible*
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $enumerate_<validator>(state.VALIDATORS) = (vid, validator)*
  -- if $filter_list_2_<(validatorIndex, validator), epoch>(
       (vid, validator)*,
       epoch_prev,
       def $is_eligible_validator_enumerated
     ) = (vid_eligible, _)*

;; [Custom | filter helper : get_unslashed_participating_indices]
dec $has_flag_for_index(validatorIndex, (participationFlags*, nat)) : bool
def $has_flag_for_index(vid, (participationFlags_list*, nat_flag))
  = $has_flag(participationFlags_list*[vid], nat_flag)
  ;; inserted guard
  -- if $(vid < |participationFlags_list*|)

;; [Custom | filter helper : get_unslashed_participating_indices]
dec $is_unslashed(validatorIndex, beaconState) : bool
def $is_unslashed(vid, state) = true
  -- if $(vid < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid] = validator
  -- if $(validator.SLASHED = false)
def $is_unslashed(vid, state) = false
  -- otherwise

;; [Altair] get_unslashed_participating_indices(BeaconState, int, Epoch) -> Set[ValidatorIndex]
dec $get_unslashed_participating_indices(beaconState, nat, epoch) : validatorIndex*
;; case 1: epoch == current
def $get_unslashed_participating_indices(state, vid_flag, epoch) = $to_set_<validatorIndex>(vid_unslashed*)
  ;; assert-branch
  -- if $get_current_epoch(state) = epoch
  -- if $get_active_validator_indices(state, epoch) = vid_active*
  -- if $filter_list_2_<validatorIndex, (participationFlags*, validatorIndex)>(
         vid_active*,
         (state.CURRENT_EPOCH_PARTICIPATION, vid_flag),
         def $has_flag_for_index
       ) = vid_participating*
  -- if $filter_list_2_<validatorIndex, beaconState>(
         vid_participating*,
         state,
         def $is_unslashed
       ) = vid_unslashed*

;; case 2: epoch == previous
def $get_unslashed_participating_indices(state, vid_flag, epoch) = $to_set_<validatorIndex>(vid_unslashed*)
  ;; assert-branch
  -- if $get_previous_epoch(state) = epoch
  -- if $get_active_validator_indices(state, epoch) = vid_active*
  -- if $filter_list_2_<validatorIndex, (participationFlags*, nat)>(
         vid_active*,
         (state.PREVIOUS_EPOCH_PARTICIPATION, vid_flag),
         def $has_flag_for_index
       ) = vid_participating*
  -- if $filter_list_2_<validatorIndex, beaconState>(
         vid_participating*,
         state,
         def $is_unslashed
       ) = vid_unslashed*

;; [Phase0] get_total_balance(BeaconState, Set[ValidatorIndex]) -> Gwei
dec $get_total_balance(beaconState, validatorIndex*) : gwei

def $get_total_balance(state, vid*)
  = $max_uint64(
      $EFFECTIVE_BALANCE_INCREMENT,
      gwei_sum
    )
  -- if (state.VALIDATORS[vid].EFFECTIVE_BALANCE = balance)*
  -- if $sum_<gwei>(balance*) = gwei_sum
  ;; inserted overflow check
  -- if $(gwei_sum <= $UINT64_MAX)

;; [Phase0] get_total_active_balance(BeaconState) -> Gwei
dec $get_total_active_balance(beaconState) : gwei

def $get_total_active_balance(state) = gwei_total
  -- if $get_current_epoch(state) = epoch_cur
  -- if $get_active_validator_indices(state, epoch_cur) = vid_active*
  -- if $to_set_<validatorIndex>(vid_active*) = vid_set*
  -- if $get_total_balance(state, vid_set*) = gwei_total

;; [Gloas:EIP8061] get_activation_churn_limit(BeaconState) -> Gwei
;;  replaces get_balance_churn_limit and get_activation_exit_churn_limit
dec $get_activation_churn_limit(beaconState) : gwei
def $get_activation_churn_limit(state) = $min_uint64($MAX_PER_EPOCH_ACTIVATION_CHURN_LIMIT_GLOAS, $(gwei_churn - gwei_churn \ $EFFECTIVE_BALANCE_INCREMENT))
  -- if $max_uint64($MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA,
                    $($get_total_active_balance(state) / $CHURN_LIMIT_QUOTIENT_GLOAS)) = gwei_churn

;; [Gloas:EIP8061] get_exit_churn_limit(BeaconState) -> Gwei
dec $get_exit_churn_limit(beaconState) : gwei
def $get_exit_churn_limit(state) = $(gwei_churn - gwei_churn \ $EFFECTIVE_BALANCE_INCREMENT)
  -- if $max_uint64($MIN_PER_EPOCH_CHURN_LIMIT_ELECTRA,
                    $($get_total_active_balance(state) / $CHURN_LIMIT_QUOTIENT_GLOAS)) = gwei_churn

;; [Modified in Gloas:EIP8061] get_consolidation_churn_limit(BeaconState) -> Gwei
dec $get_consolidation_churn_limit(beaconState) : gwei
def $get_consolidation_churn_limit(state) = $(gwei_churn - gwei_churn \ $EFFECTIVE_BALANCE_INCREMENT)
  -- if $($get_total_active_balance(state) / $CONSOLIDATION_CHURN_LIMIT_QUOTIENT) = gwei_churn

;; [Custom | filter helper : get_pending_balance_to_withdraw]
dec $is_pending_withdrawal_of(pendingPartialWithdrawal, validatorIndex) : bool
def $is_pending_withdrawal_of(pendingPartialWithdrawal, vid) = (pendingPartialWithdrawal.VALIDATOR_INDEX = vid)

;; [Electra] get_pending_balance_to_withdraw(BeaconState, ValidatorIndex) -> Gwei
dec $get_pending_balance_to_withdraw(beaconState, validatorIndex) : gwei
def $get_pending_balance_to_withdraw(state, vid) = $sum_<gwei>(gwei_amount*)
  -- if $filter_list_2_<pendingPartialWithdrawal, validatorIndex>(
         state.PENDING_PARTIAL_WITHDRAWALS, vid, def $is_pending_withdrawal_of
       ) = pendingPartialWithdrawal*
  -- if (pendingPartialWithdrawal.AMOUNT = gwei_amount)*

