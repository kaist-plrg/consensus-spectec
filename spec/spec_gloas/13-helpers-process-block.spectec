;; [Modified in Electra:EIP7251] pending partial withdrawals come before the validator sweep
relation ApplyWithdrawal:
  beaconState '.' BALANCES `{ withdrawal `} ~> beaconState
  hint(input %0 %1)

rule ApplyWithdrawal/main:
  state '.' BALANCES `{ withdrawal `} ~> state_out
  -- DecreaseBalance: state '.' BALANCES `[ withdrawal.VALIDATOR_INDEX `] '-' withdrawal.AMOUNT ~> state_out

relation ApplyWithdrawals:
  beaconState '.' BALANCES `{ withdrawal* `} ~>* beaconState
  hint(input %0 %1)

