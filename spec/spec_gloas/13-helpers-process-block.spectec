;; --------------------------------------------
;; helpers for withdrawals
;; --------------------------------------------

;; [Custom | filter helper : get_balance_after_withdrawals]
dec $is_withdrawal_of(withdrawal, validatorIndex) : bool
def $is_withdrawal_of(withdrawal, vid) = (withdrawal.VALIDATOR_INDEX = vid)

;; [Capella] get_balance_after_withdrawals(BeaconState, ValidatorIndex, Sequence[Withdrawal]) -> Gwei
;;  Electra needs it: a pending partial withdrawal and a sweep withdrawal can share a validator
dec $get_balance_after_withdrawals(beaconState, validatorIndex, withdrawal*) : gwei
def $get_balance_after_withdrawals(state, vid, withdrawal_prior*) = $(balance - gwei_withdrawn)
  ;; inserted guard (python raises IndexError)
  -- if $(vid < |state.BALANCES|)
  -- if state.BALANCES[vid] = balance
  -- if $filter_list_2_<withdrawal, validatorIndex>(withdrawal_prior*, vid, def $is_withdrawal_of) = withdrawal_v*
  -- if (withdrawal_v.AMOUNT = gwei_amount)*
  -- if $sum_<gwei>(gwei_amount*) = gwei_withdrawn
  ;; inserted underflow check (python raises on a negative Gwei)
  -- if $(gwei_withdrawn <= balance)

;; [Custom | loop : get_pending_partial_withdrawals]
;;  args: state, epoch, next withdrawal index, withdrawals_limit, prior withdrawals,
;;        pending partial withdrawals left, new withdrawals, processed count
;;  returns: (new withdrawals, next withdrawal index, processed count)
dec $pending_partial_withdrawals_loop(
  beaconState, epoch, withdrawalIndex, uint64, withdrawal*, pendingPartialWithdrawal*, withdrawal*, uint64
) : (withdrawal*, withdrawalIndex, uint64)

;; loop exhausted
def $pending_partial_withdrawals_loop(state, epoch, withdrawalIndex, uint64_limit, withdrawal_prior*, eps, withdrawal_acc*, uint64_processed)
  = (withdrawal_acc*, withdrawalIndex, uint64_processed)

;; break: not withdrawable yet, or the limit is reached
def $pending_partial_withdrawals_loop(state, epoch, withdrawalIndex, uint64_limit, withdrawal_prior*, pendingPartialWithdrawal_h :: pendingPartialWithdrawal_t*, withdrawal_acc*, uint64_processed)
  = (withdrawal_acc*, withdrawalIndex, uint64_processed)
  -- if $(pendingPartialWithdrawal_h.WITHDRAWABLE_EPOCH > epoch)
     \/ $(|withdrawal_prior*| + |withdrawal_acc*| >= uint64_limit)

;; eligible: withdraw the excess above MIN_ACTIVATION_BALANCE, up to the requested amount
def $pending_partial_withdrawals_loop(state, epoch, withdrawalIndex, uint64_limit, withdrawal_prior*, pendingPartialWithdrawal_h :: pendingPartialWithdrawal_t*, withdrawal_acc*, uint64_processed)
  = $pending_partial_withdrawals_loop(
      state, epoch, $(withdrawalIndex + 1), uint64_limit, withdrawal_prior*,
      pendingPartialWithdrawal_t*, withdrawal_acc* ++ [ withdrawal ], $(uint64_processed + 1)
    )
  -- if $(pendingPartialWithdrawal_h.WITHDRAWABLE_EPOCH <= epoch)
  -- if $(|withdrawal_prior*| + |withdrawal_acc*| < uint64_limit)
  -- if pendingPartialWithdrawal_h.VALIDATOR_INDEX = vid
  ;; inserted guard (python raises IndexError)
  -- if $(vid < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid] = validator
  -- if $get_balance_after_withdrawals(state, vid, withdrawal_prior* ++ withdrawal_acc*) = balance
  -- if $is_eligible_for_partial_withdrawals(validator, balance) = true
  ;; inserted overflow check
  -- if $(withdrawalIndex <= $UINT64_MAX - 1)
  -- if withdrawal =
       { INDEX           withdrawalIndex,
         VALIDATOR_INDEX vid,
         ADDRESS         $extract_execution_address(validator.WITHDRAWAL_CREDENTIALS),
         AMOUNT          $min_uint64($(balance - $MIN_ACTIVATION_BALANCE), pendingPartialWithdrawal_h.AMOUNT) }

;; not eligible: count it as processed
def $pending_partial_withdrawals_loop(state, epoch, withdrawalIndex, uint64_limit, withdrawal_prior*, pendingPartialWithdrawal_h :: pendingPartialWithdrawal_t*, withdrawal_acc*, uint64_processed)
  = $pending_partial_withdrawals_loop(
      state, epoch, withdrawalIndex, uint64_limit, withdrawal_prior*,
      pendingPartialWithdrawal_t*, withdrawal_acc*, $(uint64_processed + 1)
    )
  -- if $(pendingPartialWithdrawal_h.WITHDRAWABLE_EPOCH <= epoch)
  -- if $(|withdrawal_prior*| + |withdrawal_acc*| < uint64_limit)
  -- if pendingPartialWithdrawal_h.VALIDATOR_INDEX = vid
  -- if $(vid < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid] = validator
  -- if $get_balance_after_withdrawals(state, vid, withdrawal_prior* ++ withdrawal_acc*) = balance
  -- if $is_eligible_for_partial_withdrawals(validator, balance) = false

;; [Electra] get_pending_partial_withdrawals(BeaconState, WithdrawalIndex, Sequence[Withdrawal])
;;   -> (Sequence[Withdrawal], WithdrawalIndex, uint64)
dec $get_pending_partial_withdrawals(beaconState, withdrawalIndex, withdrawal*) : (withdrawal*, withdrawalIndex, uint64)
def $get_pending_partial_withdrawals(state, withdrawalIndex, withdrawal_prior*)
  = $pending_partial_withdrawals_loop(
      state, $get_current_epoch(state), withdrawalIndex, uint64_limit, withdrawal_prior*,
      state.PENDING_PARTIAL_WITHDRAWALS, eps, 0
    )
  -- if $min_uint64($(|withdrawal_prior*| + $MAX_PENDING_PARTIALS_PER_WITHDRAWALS_SWEEP),
                    $($MAX_WITHDRAWALS_PER_PAYLOAD - 1)) = uint64_limit
  ;; assert
  -- if $(|withdrawal_prior*| <= uint64_limit)

;; [Custom | loop : get_validators_sweep_withdrawals]
;;  [Modified in Electra:EIP7251] withdrawal_acc* starts with the prior withdrawals,
;;  so it is all_withdrawals, and the result is prior ++ sweep withdrawals
dec $expected_withdrawals_loop(
  beaconState, epoch, withdrawalIndex, validatorIndex, uint64, uint64, withdrawal*
) : withdrawal*

def $expected_withdrawals_loop(_, _, _, _, _, _, withdrawal_acc*)
  = withdrawal_acc*
  -- if |withdrawal_acc*| = $MAX_WITHDRAWALS_PER_PAYLOAD

def $expected_withdrawals_loop(_, _, _, _, uint64_bound, i, withdrawal_acc*)
  = withdrawal_acc*
  -- if $( i >= uint64_bound )

;; case 1: fully withdrawable
def $expected_withdrawals_loop(state, epoch, withdrawalIndex, vid, uint64_bound, i, withdrawal_acc*)
  = $expected_withdrawals_loop(
      state,
      epoch,
      $(withdrawalIndex + 1),
      $((vid + 1) \ |state.VALIDATORS|),
      uint64_bound,
      $(i + 1),
      withdrawal_acc* ++ [ withdrawal ]
    )
  ;; inserted bound check guards
  -- if $(vid < |state.VALIDATORS|)
  -- if $(vid < |state.BALANCES|)
  -- if validator = state.VALIDATORS[vid]
  -- if $get_balance_after_withdrawals(state, vid, withdrawal_acc*) = balance
  ;; branch: fully withdrawable
  -- if $is_fully_withdrawable_validator(validator, balance, epoch) = true
  ;; inserted overflow check
  -- if $(withdrawalIndex <= $UINT64_MAX - 1)
  -- if withdrawal =
       { INDEX           withdrawalIndex,
         VALIDATOR_INDEX vid,
         ADDRESS         $extract_execution_address(validator.WITHDRAWAL_CREDENTIALS),
         AMOUNT          balance }
       

;; case 2: partially withdrawable
def $expected_withdrawals_loop(state, epoch, withdrawalIndex, vid, uint64_bound, i, withdrawal_acc*)
  = $expected_withdrawals_loop(
      state,
      epoch,
      $(withdrawalIndex + 1),
      $((vid + 1) \ |state.VALIDATORS|),
      uint64_bound,
      $(i + 1),
      withdrawal_acc* ++ [ withdrawal ]
    )
  ;; inserted bound check guards
  -- if $(vid < |state.VALIDATORS|)
  -- if $(vid < |state.BALANCES|)
  -- if validator = state.VALIDATORS[vid]
  -- if $get_balance_after_withdrawals(state, vid, withdrawal_acc*) = balance
  ;; branch: partially withdrawable
  -- if $is_fully_withdrawable_validator(validator, balance, epoch) = false
  -- if $is_partially_withdrawable_validator(validator, balance) = true
  ;; inserted overflow check
  -- if $(withdrawalIndex <= $UINT64_MAX - 1)
  -- if withdrawal =
       { INDEX           withdrawalIndex,
         VALIDATOR_INDEX vid,
         ADDRESS         $extract_execution_address(validator.WITHDRAWAL_CREDENTIALS),
         AMOUNT          $( balance - $get_max_effective_balance(validator) ) }

;; case C: neither
def $expected_withdrawals_loop(state, epoch, withdrawalIndex, vid, uint64_bound, i, withdrawal_acc*)
  = $expected_withdrawals_loop(
      state,
      epoch,
      withdrawalIndex,
      $((vid + 1) \ |state.VALIDATORS|),
      uint64_bound,
      $(i + 1),
      withdrawal_acc*
    )
  ;; inserted bound check guards
  -- if $(vid < |state.VALIDATORS|)
  -- if $(vid < |state.BALANCES|)
  -- if validator = state.VALIDATORS[vid]
  -- if $get_balance_after_withdrawals(state, vid, withdrawal_acc*) = balance
  ;; branch: neither
  -- if ~ $is_fully_withdrawable_validator(validator, balance, epoch)
  -- if ~ $is_partially_withdrawable_validator(validator, balance)

;; [Gloas:EIP7732 | loop : get_builder_withdrawals]
;;  args: withdrawal index, limit, number of prior withdrawals, pending builder withdrawals, accumulator, processed count
dec $builder_withdrawals_loop(withdrawalIndex, uint64, nat, builderPendingWithdrawal*, withdrawal*, uint64)
  : (withdrawal*, withdrawalIndex, uint64)

def $builder_withdrawals_loop(withdrawalIndex, uint64_limit, n_prior, eps, withdrawal_acc*, uint64_processed)
  = (withdrawal_acc*, withdrawalIndex, uint64_processed)

def $builder_withdrawals_loop(withdrawalIndex, uint64_limit, n_prior, builderPendingWithdrawal_h :: builderPendingWithdrawal_t*, withdrawal_acc*, uint64_processed)
  = (withdrawal_acc*, withdrawalIndex, uint64_processed)
  -- if $(n_prior + |withdrawal_acc*| >= uint64_limit)

def $builder_withdrawals_loop(withdrawalIndex, uint64_limit, n_prior, builderPendingWithdrawal_h :: builderPendingWithdrawal_t*, withdrawal_acc*, uint64_processed)
  = $builder_withdrawals_loop(
      $(withdrawalIndex + 1), uint64_limit, n_prior, builderPendingWithdrawal_t*,
      withdrawal_acc* ++ [ withdrawal ], $(uint64_processed + 1)
    )
  -- if $(n_prior + |withdrawal_acc*| < uint64_limit)
  -- if withdrawal =
       { INDEX           withdrawalIndex,
         VALIDATOR_INDEX $convert_builder_index_to_validator_index(builderPendingWithdrawal_h.BUILDER_INDEX),
         ADDRESS         builderPendingWithdrawal_h.FEE_RECIPIENT,
         AMOUNT          builderPendingWithdrawal_h.AMOUNT }

;; [Gloas:EIP7732] get_builder_withdrawals(BeaconState, WithdrawalIndex, Sequence[Withdrawal])
;;   -> tuple[Sequence[Withdrawal], WithdrawalIndex, Uint64]
dec $get_builder_withdrawals(beaconState, withdrawalIndex, withdrawal*) : (withdrawal*, withdrawalIndex, uint64)
def $get_builder_withdrawals(state, withdrawalIndex, withdrawal_prior*)
  = $builder_withdrawals_loop(withdrawalIndex, uint64_limit, |withdrawal_prior*|, state.BUILDER_PENDING_WITHDRAWALS, eps, 0)
  -- if $($MAX_WITHDRAWALS_PER_PAYLOAD - 1) = uint64_limit
  ;; assert
  -- if $(|withdrawal_prior*| <= uint64_limit)

;; [Gloas:EIP7732] get_builder_balance_after_withdrawals(BeaconState, BuilderIndex, Sequence[Withdrawal]) -> Gwei
dec $get_builder_balance_after_withdrawals(beaconState, builderIndex, withdrawal*) : gwei
def $get_builder_balance_after_withdrawals(state, builderIndex, withdrawal_prior*)
  = $saturating_sub(state.BUILDERS[builderIndex].BALANCE, gwei_withdrawn)
  ;; inserted guard (python raises IndexError)
  -- if $(builderIndex < |state.BUILDERS|)
  -- if $filter_list_2_<withdrawal, validatorIndex>(
         withdrawal_prior*, $convert_builder_index_to_validator_index(builderIndex), def $is_withdrawal_of
       ) = withdrawal_b*
  -- if (withdrawal_b.AMOUNT = gwei_amount)*
  -- if $sum_<gwei>(gwei_amount*) = gwei_withdrawn

;; [Gloas:EIP7732 | loop : get_builders_sweep_withdrawals]
;;  args: state, epoch, withdrawal index, builder index, iterations left, limit, prior withdrawals, accumulator, processed count
dec $builders_sweep_loop(beaconState, epoch, withdrawalIndex, builderIndex, uint64, uint64, withdrawal*, withdrawal*, uint64)
  : (withdrawal*, withdrawalIndex, uint64)

;; range exhausted
def $builders_sweep_loop(state, epoch, withdrawalIndex, builderIndex, uint64_left, uint64_limit, withdrawal_prior*, withdrawal_acc*, uint64_processed)
  = (withdrawal_acc*, withdrawalIndex, uint64_processed)
  -- if uint64_left = 0

;; limit reached: break
def $builders_sweep_loop(state, epoch, withdrawalIndex, builderIndex, uint64_left, uint64_limit, withdrawal_prior*, withdrawal_acc*, uint64_processed)
  = (withdrawal_acc*, withdrawalIndex, uint64_processed)
  -- if $(uint64_left > 0)
  -- if $(|withdrawal_prior*| + |withdrawal_acc*| >= uint64_limit)

;; withdrawable builder with a balance: withdraw it
def $builders_sweep_loop(state, epoch, withdrawalIndex, builderIndex, uint64_left, uint64_limit, withdrawal_prior*, withdrawal_acc*, uint64_processed)
  = $builders_sweep_loop(
      state, epoch, $(withdrawalIndex + 1), $((builderIndex + 1) \ |state.BUILDERS|), $(uint64_left - 1), uint64_limit,
      withdrawal_prior*, withdrawal_acc* ++ [ withdrawal ], $(uint64_processed + 1)
    )
  -- if $(uint64_left > 0)
  -- if $(|withdrawal_prior*| + |withdrawal_acc*| < uint64_limit)
  ;; inserted guard (python raises IndexError)
  -- if $(builderIndex < |state.BUILDERS|)
  -- if state.BUILDERS[builderIndex] = builder
  -- if $get_builder_balance_after_withdrawals(state, builderIndex, withdrawal_prior* ++ withdrawal_acc*) = balance
  -- if $(builder.WITHDRAWABLE_EPOCH <= epoch)
  -- if $(balance > 0)
  -- if withdrawal =
       { INDEX           withdrawalIndex,
         VALIDATOR_INDEX $convert_builder_index_to_validator_index(builderIndex),
         ADDRESS         builder.EXECUTION_ADDRESS,
         AMOUNT          balance }

;; otherwise: next builder
def $builders_sweep_loop(state, epoch, withdrawalIndex, builderIndex, uint64_left, uint64_limit, withdrawal_prior*, withdrawal_acc*, uint64_processed)
  = $builders_sweep_loop(
      state, epoch, withdrawalIndex, $((builderIndex + 1) \ |state.BUILDERS|), $(uint64_left - 1), uint64_limit,
      withdrawal_prior*, withdrawal_acc*, $(uint64_processed + 1)
    )
  -- if $(uint64_left > 0)
  -- if $(|withdrawal_prior*| + |withdrawal_acc*| < uint64_limit)
  -- if $(builderIndex < |state.BUILDERS|)
  -- if state.BUILDERS[builderIndex] = builder
  -- if $get_builder_balance_after_withdrawals(state, builderIndex, withdrawal_prior* ++ withdrawal_acc*) = balance
  -- if ~($(builder.WITHDRAWABLE_EPOCH <= epoch) /\ $(balance > 0))

;; [Gloas:EIP7732] get_builders_sweep_withdrawals(BeaconState, WithdrawalIndex, Sequence[Withdrawal])
;;   -> tuple[Sequence[Withdrawal], WithdrawalIndex, Uint64]
dec $get_builders_sweep_withdrawals(beaconState, withdrawalIndex, withdrawal*) : (withdrawal*, withdrawalIndex, uint64)
def $get_builders_sweep_withdrawals(state, withdrawalIndex, withdrawal_prior*)
  = $builders_sweep_loop(
      state, $get_current_epoch(state), withdrawalIndex, state.NEXT_WITHDRAWAL_BUILDER_INDEX,
      $min_uint64(|state.BUILDERS|, $MAX_BUILDERS_PER_WITHDRAWALS_SWEEP), uint64_limit,
      withdrawal_prior*, eps, 0
    )
  -- if $($MAX_WITHDRAWALS_PER_PAYLOAD - 1) = uint64_limit
  ;; assert
  -- if $(|withdrawal_prior*| <= uint64_limit)

;; [Capella -> Electra -> Gloas] get_expected_withdrawals(BeaconState) -> ExpectedWithdrawals
;;  The validator sweep is $expected_withdrawals_loop (get_validators_sweep_withdrawals).
;;  Its accumulator starts with the prior withdrawals.
dec $get_expected_withdrawals(beaconState) : expectedWithdrawals

def $get_expected_withdrawals(state)
  = { WITHDRAWALS                         withdrawal_all*,
      PROCESSED_BUILDER_WITHDRAWALS_COUNT uint64_builder_count,
      PROCESSED_PARTIAL_WITHDRAWALS_COUNT uint64_partial_count,
      PROCESSED_BUILDERS_SWEEP_COUNT      uint64_builders_sweep_count }
  ;; [New in Gloas:EIP7732] builder withdrawals
  -- if $get_builder_withdrawals(state, state.NEXT_WITHDRAWAL_INDEX, eps)
       = (withdrawal_builder*, withdrawalIndex_1, uint64_builder_count)
  ;; partial withdrawals
  -- if $get_pending_partial_withdrawals(state, withdrawalIndex_1, withdrawal_builder*)
       = (withdrawal_partial*, withdrawalIndex_2, uint64_partial_count)
  ;; [New in Gloas:EIP7732] builders sweep withdrawals
  -- if $get_builders_sweep_withdrawals(state, withdrawalIndex_2, withdrawal_builder* ++ withdrawal_partial*)
       = (withdrawal_sweep*, withdrawalIndex_3, uint64_builders_sweep_count)
  -- if withdrawal_prior* = withdrawal_builder* ++ withdrawal_partial* ++ withdrawal_sweep*
  ;; validators sweep withdrawals
  ;; assert: There must be at least one space reserved for validator sweep withdrawals
  -- if $(|withdrawal_prior*| < $MAX_WITHDRAWALS_PER_PAYLOAD)
  -- if $expected_withdrawals_loop(
         state, $get_current_epoch(state), withdrawalIndex_3, state.NEXT_WITHDRAWAL_VALIDATOR_INDEX,
         $min_uint64(|state.VALIDATORS|, $MAX_VALIDATORS_PER_WITHDRAWALS_SWEEP), 0, withdrawal_prior*
       ) = withdrawal_all*

;; [Capella -> Gloas] apply one withdrawal
relation ApplyWithdrawal:
  beaconState '.' BALANCES `{ withdrawal `} ~> beaconState
  hint(input %0 %1)

;; [Modified in Gloas:EIP7732] a builder withdrawal decreases the builder balance
rule ApplyWithdrawal/builder:
  state '.' BALANCES `{ withdrawal `}
  ~> state[.BUILDERS[builderIndex].BALANCE = $saturating_sub(state.BUILDERS[builderIndex].BALANCE, withdrawal.AMOUNT)]
  -- if $is_builder_index(withdrawal.VALIDATOR_INDEX) = true
  -- if $convert_validator_index_to_builder_index(withdrawal.VALIDATOR_INDEX) = builderIndex
  ;; inserted guard (python raises IndexError)
  -- if $(builderIndex < |state.BUILDERS|)

rule ApplyWithdrawal/validator:
  state '.' BALANCES `{ withdrawal `} ~> state_out
  -- if $is_builder_index(withdrawal.VALIDATOR_INDEX) = false
  -- DecreaseBalance: state '.' BALANCES `[ withdrawal.VALIDATOR_INDEX `] '-' withdrawal.AMOUNT ~> state_out

;; [Capella -> Gloas] apply_withdrawals(state, withdrawals)
relation ApplyWithdrawals:
  beaconState '.' BALANCES `{ withdrawal* `} ~>* beaconState
  hint(input %0 %1)

rule ApplyWithdrawals/fold:
  state '.' BALANCES `{ withdrawal* `} ~>* state_out
  -- (ApplyWithdrawal: state_cur '.' BALANCES `{ withdrawal `} ~> state_next)*{
       state -> state_cur ... state_next -> state_out
     }

;; [Custom]
;; loop helper for ProcessAttestation
relation AddFlag:
  participationFlags `[ validatorIndex `] '++' `{ validatorIndex `} '#' beaconState '#' SUM gwei ~> participationFlags '#' SUM gwei
  hint(input %0 %1 %2 %3 %4)

rule AddFlag/main:
  participationFlags `[ vid_attesting `] '++' `{ vid_flag `} '#' state '#' SUM reward
    ~>
    $add_flag(participationFlags, vid_flag)
    '#' SUM $(reward + reward_base * $PARTICIPATION_FLAG_WEIGHTS[vid_flag])
  -- if ~$has_flag(participationFlags, vid_flag)
  -- if $get_base_reward(state, vid_attesting) = reward_base
rule AddFlag/skip:
  participationFlags `[ _ `] '++' `{ vid_flag `} '#' _ '#' SUM reward ~> participationFlags '#' SUM reward
  -- if $has_flag(participationFlags, vid_flag)

;; [Custom]
;; fold AddFlag over flag indices
relation AddFlags:
  participationFlags `[ validatorIndex `] '++' `{ validatorIndex* `} '#' beaconState '#' SUM gwei
    ~> participationFlags '#' SUM gwei
  hint(input %0 %1 %2 %3 %4)

rule AddFlags/fold:
  participationFlags_0 `[ vid_attesting `] '++' `{ vid_flag* `} '#' state '#' SUM reward_0
    ~> participationFlags_n '#' SUM reward_n
  -- (AddFlag: participationFlags_cur `[ vid_attesting `] '++' `{ vid_flag `} '#' state '#' SUM reward_cur
        ~> participationFlags_next '#' SUM reward_next)*{
       participationFlags_0 -> participationFlags_cur ... participationFlags_next -> participationFlags_n,
       reward_0 -> reward_cur ... reward_next -> reward_n
     }

;; [Custom]
;; iterate AddFlags over participation flags
relation ProcessFlags:
  participationFlags* `[ validatorIndex `] '++' `{ validatorIndex* `} '#' beaconState '#' SUM gwei
    ~> participationFlags* '#' SUM gwei
  hint(input %0 %1 %2 %3 %4)

rule ProcessFlags/main:
  participationFlags* `[ vid_attesting `] '++' `{ vid_flag* `} '#' state '#' SUM reward
    ~>
    (participationFlags*[ [vid_attesting] = participationFlags_updated ])
    '#' SUM $(reward + reward_increment)
  -- if $(vid_attesting < |participationFlags*|)
  -- AddFlags: participationFlags*[vid_attesting] `[vid_attesting`] '++' `{ vid_flag* `} '#' state '#' SUM 0
      ~> participationFlags_updated '#' SUM reward_increment

;; [Custom]
;; fold ProcessFlags over attesting indices
relation ProcessFlags_over_attesting:
  participationFlags* `[ validatorIndex* `] '++' `{ validatorIndex* `} '#' beaconState '#' SUM gwei
    ~> participationFlags* '#' SUM gwei
  hint(input %0 %1 %2 %3 %4)

rule ProcessFlags_over_attesting/fold:
  participationFlags_0* `[ vid_attesting* `] '++' `{ vid_flag* `} '#' state '#' SUM reward_0
    ~> participationFlags_n* '#' SUM reward_n
  -- (ProcessFlags: participationFlags_cur* `[ vid_attesting `] '++' `{ vid_flag* `} '#' state '#' SUM reward_cur
        ~> participationFlags_next* '#' SUM reward_next)*{
       participationFlags_0* -> participationFlags_cur* ... participationFlags_next* -> participationFlags_n*,
       reward_0 -> reward_cur ... reward_next -> reward_n
     }

;; process_sync_aggregate
dec $bit_is_one_en_blsPubkey(enumerated_<blsPubkey>, boolean*) : bool
def $bit_is_one_en_blsPubkey((i, blsPubkey), boolean_bits*) = true
  -- if $(i < |boolean_bits*|)
  -- if boolean_bits*[i] = true
def $bit_is_one_en_blsPubkey((i, blsPubkey), boolean_bits*) = false
  -- otherwise

;; [Custom]
;; loop helper for ProcessSyncAggregate
relation ApplyReward:
  beaconState
    PARTICIPANT boolean `[ validatorIndex `] '+' gwei
    PROPOSER `[ validatorIndex `] '+' gwei
      ~> beaconState
  hint(input %0 %1 %2 %3 %4 %5)

rule ApplyReward/participation:
  state
    PARTICIPANT true `[ vid_participant `] '+' reward_participant
    PROPOSER `[ vid_proposer `] '+' reward_proposer
      ~> state_out
  -- IncreaseBalance: state '.' BALANCES `[ vid_participant `] '+' reward_participant ~> state_participant
  -- IncreaseBalance: state_participant '.' BALANCES `[ vid_proposer `] '+' reward_proposer ~> state_out

rule ApplyReward/no_participation:
  state
    PARTICIPANT false `[ vid_participant `] '+' reward_participant
    PROPOSER `[ _ `] '+' _
      ~> state_out
  -- DecreaseBalance: state '.' BALANCES `[ vid_participant `] '-' reward_participant ~> state_out

;; [Custom]
;; fold ApplyReward over vid_participant and bit_participating
relation ApplyReward_over_participants:
  beaconState
    PARTICIPANT boolean* `[ validatorIndex* `] '+' gwei
    PROPOSER `[ validatorIndex `] '+' gwei
      ~> beaconState
    hint(input %0 %1 %2 %3 %4 %5)

rule ApplyReward_over_participants/fold:
  state
    PARTICIPANT boolean* `[ vid_participant* `] '+' reward_participant
    PROPOSER `[ vid_proposer `] '+' reward_proposer
      ~> state_out
  -- (ApplyReward:
        state_cur
          PARTICIPANT boolean `[ vid_participant `] '+' reward_participant
          PROPOSER `[ vid_proposer `] '+' reward_proposer
            ~> state_next)*{
       state -> state_cur ... state_next -> state_out
     }
  
