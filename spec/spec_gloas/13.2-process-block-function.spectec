;;
;; [Phase0]
;; process_block_header
;;  mutates: LATEST_BLOCK_HEADER
;;

relation ProcessBlockHeader:
  beaconState beaconBlock ~> beaconState
  hint(input %0 %1)

rule ProcessBlockHeader:
  state block ~> state[.LATEST_BLOCK_HEADER = beaconBlockHeader_new]
  ;; assert 1: slots match
  -- if block.SLOT = state.SLOT
  ;; assert 2: block is newer than latest block header
  -- if $(state.LATEST_BLOCK_HEADER.SLOT < block.SLOT)
  ;; assert 3: block proposer is correct
  -- if $get_beacon_proposer_index(state) = block.PROPOSER_INDEX
  ;; assert 4: parent matches
  -- if block.PARENT_ROOT = $hash_tree_root_beaconBlockHeader(state.LATEST_BLOCK_HEADER)
  -- if beaconBlockHeader_new =
       { SLOT block.SLOT,
         PROPOSER_INDEX block.PROPOSER_INDEX,
         PARENT_ROOT block.PARENT_ROOT,
         STATE_ROOT $ZERO_ROOT,
         BODY_ROOT $hash_tree_root_beaconBlockBody(block.BODY) }
  ;; inserted: bound check
  -- if $(block.PROPOSER_INDEX < |state.VALIDATORS|)
  ;; assert 5: proposer is not slashed
  -- if ~state.VALIDATORS[block.PROPOSER_INDEX].SLASHED


;; [Capella -> Electra -> Gloas]
;; process_withdrawals(state)
;;  mutates: .BALANCES, .BUILDERS, .NEXT_WITHDRAWAL_INDEX, .PAYLOAD_EXPECTED_WITHDRAWALS,
;;    .BUILDER_PENDING_WITHDRAWALS, .PENDING_PARTIAL_WITHDRAWALS,
;;    .NEXT_WITHDRAWAL_BUILDER_INDEX, .NEXT_WITHDRAWAL_VALIDATOR_INDEX

;; [Capella] update_next_withdrawal_index: the index after the latest withdrawal, if any
dec $next_withdrawal_index_after(beaconState, withdrawal*) : withdrawalIndex
def $next_withdrawal_index_after(state, eps) = state.NEXT_WITHDRAWAL_INDEX
def $next_withdrawal_index_after(state, withdrawal*) = $(withdrawal_latest.INDEX + 1)
  -- if $(|withdrawal*| > 0)
  -- if withdrawal*[|withdrawal*| - 1] = withdrawal_latest

;; [Gloas:EIP7732] update_next_withdrawal_builder_index
dec $next_withdrawal_builder_index_after(beaconState, uint64) : builderIndex
def $next_withdrawal_builder_index_after(state, uint64_processed) = state.NEXT_WITHDRAWAL_BUILDER_INDEX
  -- if |state.BUILDERS| = 0
def $next_withdrawal_builder_index_after(state, uint64_processed)
  = $((state.NEXT_WITHDRAWAL_BUILDER_INDEX + uint64_processed) \ |state.BUILDERS|)
  -- if $(|state.BUILDERS| > 0)

;; [Capella] update_next_withdrawal_validator_index
dec $next_withdrawal_validator_index_after(beaconState, withdrawal*) : validatorIndex
;; a full set: the sweep starts after the latest withdrawal's validator index
def $next_withdrawal_validator_index_after(state, withdrawal*)
  = $((withdrawal_latest.VALIDATOR_INDEX + 1) \ |state.VALIDATORS|)
  -- if |withdrawal*| = $MAX_WITHDRAWALS_PER_PAYLOAD
  -- if withdrawal*[|withdrawal*| - 1] = withdrawal_latest
;; otherwise: advance by the max length of the sweep
def $next_withdrawal_validator_index_after(state, withdrawal*)
  = $((state.NEXT_WITHDRAWAL_VALIDATOR_INDEX + $MAX_VALIDATORS_PER_WITHDRAWALS_SWEEP) \ |state.VALIDATORS|)
  -- if |withdrawal*| =/= $MAX_WITHDRAWALS_PER_PAYLOAD

relation ProcessWithdrawals:
  beaconState ~> beaconState
  hint(input %0)

;; [New in Gloas:EIP7732] the parent block is empty: no withdrawals
rule ProcessWithdrawals/parent_empty:
  state ~> state
  -- if state.LATEST_BLOCK_HASH =/= state.LATEST_EXECUTION_PAYLOAD_BID.BLOCK_HASH

rule ProcessWithdrawals/main:
  state ~>
    state_after_debits
      [.NEXT_WITHDRAWAL_INDEX = $next_withdrawal_index_after(state_after_debits, withdrawal_expected*)]
      [.PAYLOAD_EXPECTED_WITHDRAWALS = withdrawal_expected*]
      [.BUILDER_PENDING_WITHDRAWALS = $drop_prefix_<builderPendingWithdrawal>(
          state_after_debits.BUILDER_PENDING_WITHDRAWALS, expectedWithdrawals.PROCESSED_BUILDER_WITHDRAWALS_COUNT)]
      [.PENDING_PARTIAL_WITHDRAWALS = $drop_prefix_<pendingPartialWithdrawal>(
          state_after_debits.PENDING_PARTIAL_WITHDRAWALS, expectedWithdrawals.PROCESSED_PARTIAL_WITHDRAWALS_COUNT)]
      [.NEXT_WITHDRAWAL_BUILDER_INDEX = $next_withdrawal_builder_index_after(
          state_after_debits, expectedWithdrawals.PROCESSED_BUILDERS_SWEEP_COUNT)]
      [.NEXT_WITHDRAWAL_VALIDATOR_INDEX = $next_withdrawal_validator_index_after(state_after_debits, withdrawal_expected*)]
  -- if state.LATEST_BLOCK_HASH = state.LATEST_EXECUTION_PAYLOAD_BID.BLOCK_HASH
  -- if $get_expected_withdrawals(state) = expectedWithdrawals
  -- if expectedWithdrawals.WITHDRAWALS = withdrawal_expected*
  -- ApplyWithdrawals: state '.' BALANCES `{ withdrawal_expected* `} ~>* state_after_debits

