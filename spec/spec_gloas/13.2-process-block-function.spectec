;; [Phase0]
;; process_eth1_data
;;  mutates: ETH1_DATA, ETH1_DATA_VOTES (append)

relation ProcessEth1Data:
  beaconState beaconBlockBody ~> beaconState
  hint(input %0 %1)

rule ProcessEth1Data/majority:
  state body ~> (state[.ETH1_DATA_VOTES = eth1Data_update*][.ETH1_DATA = body.ETH1_DATA])
  -- if state.ETH1_DATA_VOTES ++ [ body.ETH1_DATA ] = eth1Data_update*
  -- if $count_occurrences_<eth1Data>(eth1Data_update*, body.ETH1_DATA) = n_occ
  ;; branch-complete
  -- if $(n_occ * 2 > $EPOCHS_PER_ETH1_VOTING_PERIOD * $SLOTS_PER_EPOCH)

rule ProcessEth1Data/accumulate:
  state body ~> state[.ETH1_DATA_VOTES = eth1Data_update*]
  -- if state.ETH1_DATA_VOTES ++ [ body.ETH1_DATA ] = eth1Data_update*
