;; =========================
;; [Fulu] declarations that Gloas calls
;; =========================
;; The Fulu port fills these in spec/spec_fulu. Until that merge, they are declarations
;; without definitions. Delete this file when the Fulu bodies arrive.

;; [Fulu] BlobParameters (dataclass)
syntax blobParameters =
  { EPOCH epoch,
    MAX_BLOBS_PER_BLOCK uint64 }

;; [Fulu] get_blob_parameters(Epoch) -> BlobParameters
dec $get_blob_parameters(epoch) : blobParameters

;; [Fulu] process_proposer_lookahead(state)
relation ProcessProposerLookahead:
  beaconState ~> beaconState
  hint(input %0)
