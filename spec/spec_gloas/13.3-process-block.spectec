;; process_block

;; [Modified in Gloas:EIP7732] the parent payload comes first, the bid replaces the payload,
;;  and process_operations gets the parent slot
relation ProcessBlock:
  beaconState beaconBlock ~>* beaconState
  hint(input %0 %1)

rule ProcessBlock:
  state block ~>* state_7
  ;; [New in Gloas:EIP7732]
