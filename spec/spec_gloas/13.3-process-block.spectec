  -- ProcessBlockHeader:           state_0   block                                       ~>  state_1
  ;; Capella -> Electra -> Gloas
  -- ProcessWithdrawals:           state_1                                               ~>  state_2
  ;; [New in Gloas:EIP7732]
  -- ProcessExecutionPayloadBid:   state_2   block.BODY.SIGNED_EXECUTION_PAYLOAD_BID     ~>  state_3
  ;; Phase0
  -- ProcessRandao:                state_3   block.BODY                                  ~>  state_4
  ;; Phase0
  -- ProcessEth1Data:              state_4   block.BODY                                  ~>  state_5
  ;; Phase0 -> Altair -> Capella -> Electra -> Fulu -> Gloas
  -- ProcessOperations:            state_5   block.BODY slot_parent                      ~>  state_6
