;; [Custom | loop : compute_ptc] the committees of a slot, concatenated in order
dec $slot_committees(beaconState, slot, committeeIndex*) : validatorIndex*
def $slot_committees(state, slot, eps) = eps
def $slot_committees(state, slot, committeeIndex_h :: committeeIndex_t*)
  = $get_beacon_committee(state, slot, committeeIndex_h) ++ $slot_committees(state, slot, committeeIndex_t*)

;; [Gloas] compute_ptc(BeaconState, Slot) -> PayloadTimelinessCommittee
dec $compute_ptc(beaconState, slot) : validatorIndex*
def $compute_ptc(state, slot) = $compute_balance_weighted_selection(state, vid*, seed, $PTC_SIZE, false)
  -- if $compute_epoch_at_slot(slot) = epoch
  -- if $hash_<bytes>($concat_bytes($bytes32_to_bytes($get_seed(state, epoch, $DOMAIN_PTC_ATTESTER)),
                                    $uint64_to_bytes_le(slot))) = seed
  -- if $range($get_committee_count_per_slot(state, epoch)) = n*
  -- if $slot_committees(state, slot, n*) = vid*

;; [Gloas] get_ptc(BeaconState, Slot) -> PayloadTimelinessCommittee
dec $get_ptc(beaconState, slot) : validatorIndex*
;; previous epoch
def $get_ptc(state, slot) = state.PTC_WINDOW[uint64_w]
  -- if $(slot \ $SLOTS_PER_EPOCH) = uint64_w
  ;; inserted guard
  -- if $(uint64_w < |state.PTC_WINDOW|)
  -- if $compute_epoch_at_slot(slot) = epoch
  -- if $(epoch >= $GLOAS_FORK_EPOCH)
  -- if $get_current_epoch(state) = epoch_state
  -- if $(epoch < epoch_state)
  ;; assert
  -- if $(epoch + 1 = epoch_state)
;; current or lookahead epoch
def $get_ptc(state, slot) = state.PTC_WINDOW[uint64_w]
  -- if $compute_epoch_at_slot(slot) = epoch
  -- if $(epoch >= $GLOAS_FORK_EPOCH)
  -- if $get_current_epoch(state) = epoch_state
  -- if $(epoch >= epoch_state)
  ;; assert
  -- if $(epoch <= epoch_state + $MIN_SEED_LOOKAHEAD)
  -- if $((epoch - epoch_state + 1) * $SLOTS_PER_EPOCH) = uint64_offset
  -- if $(slot \ $SLOTS_PER_EPOCH) = uint64_i
  -- if $(uint64_offset + uint64_i) = uint64_w
  ;; inserted guard
