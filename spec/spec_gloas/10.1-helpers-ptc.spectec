;; [Gloas] get_indexed_payload_attestation(BeaconState, PayloadAttestation) -> IndexedPayloadAttestation
dec $get_indexed_payload_attestation(beaconState, payloadAttestation) : indexedPayloadAttestation
def $get_indexed_payload_attestation(state, payloadAttestation)
  = { ATTESTING_INDICES $sort_<validatorIndex>(vid_attesting*),
      DATA payloadAttestation.DATA,
      SIGNATURE payloadAttestation.SIGNATURE }
  -- if $get_ptc(state, payloadAttestation.DATA.SLOT) = vid_ptc*
  -- if $enumerate_<validatorIndex>(vid_ptc*) = (i, vid)*
  -- if $filter_list_2_<(nat, validatorIndex), boolean*>(
         (i, vid)*, payloadAttestation.AGGREGATION_BITS, def $bit_is_one_at_index
       ) = (_, vid_attesting)*


;; [Gloas] is_valid_indexed_payload_attestation(BeaconState, IndexedPayloadAttestation) -> bool
dec $is_valid_indexed_payload_attestation(beaconState, indexedPayloadAttestation) : bool
;; false: empty list
def $is_valid_indexed_payload_attestation(state, indexedPayloadAttestation) = false
  -- if |indexedPayloadAttestation.ATTESTING_INDICES| = 0
;; false: not sorted (duplicates are allowed)
def $is_valid_indexed_payload_attestation(state, indexedPayloadAttestation) = false
  -- if $sort_<validatorIndex>(indexedPayloadAttestation.ATTESTING_INDICES)
     =/= indexedPayloadAttestation.ATTESTING_INDICES
;; otherwise: verify the aggregate signature
def $is_valid_indexed_payload_attestation(state, indexedPayloadAttestation)
  = $bls_fast_aggregate_verify(blsPubkey*, root_signing, indexedPayloadAttestation.SIGNATURE)
  -- if vid* = indexedPayloadAttestation.ATTESTING_INDICES
  -- if $(|vid*| > 0)
  -- if $sort_<validatorIndex>(vid*) = vid*
  ;; inserted guard
  -- if ($(vid < |state.VALIDATORS|))*
  -- if (state.VALIDATORS[vid].PUBKEY = blsPubkey)*
  -- if $get_domain(state, $DOMAIN_PTC_ATTESTER,
                    $compute_epoch_at_slot(indexedPayloadAttestation.DATA.SLOT)) = domain
