;; loop exhausted
;; break before reading the validator
;; withdrawn: apply without consuming churn
;; exited: postpone
;; churn limit reached: break with the flag set
;; within churn: consume and apply
;; === ProcessPendingConsolidations ===

;; [Custom | loop : process_pending_consolidations]
;;  loop-carried: next_pending_consolidation
relation ProcessPendingConsolidations_loop:
  beaconState WITH nat OVER `[ pendingConsolidation* `] ~> beaconState WITH nat
  hint(input %0 %1 %2)

;; loop exhausted
rule ProcessPendingConsolidations_loop/nil:
  state WITH n OVER `[ eps `] ~> state WITH n

;; slashed source: skip it
rule ProcessPendingConsolidations_loop/slashed:
  state WITH n OVER `[ pendingConsolidation_h :: pendingConsolidation_t* `] ~> state_out WITH n_out
  ;; inserted guard (python raises IndexError)
  -- if $(pendingConsolidation_h.SOURCE_INDEX < |state.VALIDATORS|)
  -- if state.VALIDATORS[pendingConsolidation_h.SOURCE_INDEX] = validator_source
  -- if validator_source.SLASHED = true
  -- ProcessPendingConsolidations_loop:
       state WITH $(n + 1) OVER `[ pendingConsolidation_t* `] ~> state_out WITH n_out

;; source not yet withdrawable: break
rule ProcessPendingConsolidations_loop/stop:
  state WITH n OVER `[ pendingConsolidation_h :: pendingConsolidation_t* `] ~> state WITH n
  -- if $(pendingConsolidation_h.SOURCE_INDEX < |state.VALIDATORS|)
  -- if state.VALIDATORS[pendingConsolidation_h.SOURCE_INDEX] = validator_source
  -- if validator_source.SLASHED = false
  -- if $(validator_source.WITHDRAWABLE_EPOCH > $get_current_epoch(state) + 1)

;; move the active balance of the source to the target
rule ProcessPendingConsolidations_loop/apply:
  state WITH n OVER `[ pendingConsolidation_h :: pendingConsolidation_t* `] ~> state_out WITH n_out
  -- if $(pendingConsolidation_h.SOURCE_INDEX < |state.VALIDATORS|)
  -- if state.VALIDATORS[pendingConsolidation_h.SOURCE_INDEX] = validator_source
  -- if validator_source.SLASHED = false
  -- if $(validator_source.WITHDRAWABLE_EPOCH <= $get_current_epoch(state) + 1)
  ;; Calculate the consolidated balance
  -- if $(pendingConsolidation_h.SOURCE_INDEX < |state.BALANCES|)
  -- if $min_uint64(state.BALANCES[pendingConsolidation_h.SOURCE_INDEX],
                    validator_source.EFFECTIVE_BALANCE) = balance_source_effective
  ;; Move active balance to target. Excess balance is withdrawable.
  -- DecreaseBalance:
       state '.' BALANCES `[ pendingConsolidation_h.SOURCE_INDEX `] '-' balance_source_effective ~> state_1
  -- IncreaseBalance:
       state_1 '.' BALANCES `[ pendingConsolidation_h.TARGET_INDEX `] '+' balance_source_effective ~> state_2
  -- ProcessPendingConsolidations_loop:
       state_2 WITH $(n + 1) OVER `[ pendingConsolidation_t* `] ~> state_out WITH n_out
