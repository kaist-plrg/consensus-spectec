;;      fee_recipient: ExecutionAddress
;; @@ -13,8 +15,12 @@
;;      base_fee_per_gas: Uint256
;;      block_hash: Hash32
;; +    # [Modified in Gloas:EIP7688]
;;      transactions: Transactions
;; +    # [Modified in Gloas:EIP7688]
;;      withdrawals: Withdrawals
;; -    # [New in Deneb:EIP4844]
;;      blob_gas_used: Uint64
;; -    # [New in Deneb:EIP4844]
;;      excess_blob_gas: Uint64
;; +    # [New in Gloas:EIP7928]
;; +    block_access_list: BlockAccessList
;; +    # [New in Gloas:EIP7843]
;; +    slot_number: Uint64

syntax executionPayload =
  { PARENT_HASH hash32,
    FEE_RECIPIENT executionAddress,
    STATE_ROOT bytes32,
    RECEIPTS_ROOT bytes32,
    LOGS_BLOOM bytes256,
    PREV_RANDAO bytes32,
    BLOCK_NUMBER uint64,
    GAS_LIMIT uint64,
    GAS_USED uint64,
    TIMESTAMP uint64,
    EXTRA_DATA bytes,
    BASE_FEE_PER_GAS uint256,
    BLOCK_HASH hash32,
    TRANSACTIONS bytes*,
    WITHDRAWALS withdrawal*,
    ;;[Deneb] 
    BLOB_GAS_USED uint64,
    EXCESS_BLOB_GAS uint64 }

;; signedBlsToExecutionChange

syntax blsToExecutionChange =
  { VALIDATOR_INDEX validatorIndex,
    FROM_BLS_PUBKEY blsPubkey,
    TO_EXECUTION_ADDRESS executionAddress }

syntax signedBlsToExecutionChange =
  { MESSAGE blsToExecutionChange,
    SIGNATURE blsSignature }

;; executionRequests [Electra]

syntax depositRequest =
  { PUBKEY blsPubkey,
    WITHDRAWAL_CREDENTIALS bytes32,
    AMOUNT gwei,
    SIGNATURE blsSignature,
    INDEX uint64 }

syntax withdrawalRequest =
  { SOURCE_ADDRESS executionAddress,
    VALIDATOR_PUBKEY blsPubkey,
    AMOUNT gwei }

syntax consolidationRequest =
  { SOURCE_ADDRESS executionAddress,
    SOURCE_PUBKEY blsPubkey,
    TARGET_PUBKEY blsPubkey }

;; TODO(gloas): ssz_objects `ExecutionRequests` changed upstream in specs/gloas/beacon-chain.md
;; edit the type/fields by hand; callers listed in PLAN.md
;; --- old
;; +++ new
;; @@ -1,7 +1,10 @@
;; -class ExecutionRequests(Container):
;; -    # [New in Electra:EIP6110]
;; +class ExecutionRequests(ProgressiveContainer):
;; +    ACTIVE_FIELDS = active_fields(width=5)
;; +
;;      deposits: DepositRequests
;; -    # [New in Electra:EIP7002:EIP7251]
;;      withdrawals: WithdrawalRequests
;; -    # [New in Electra:EIP7251]
;;      consolidations: ConsolidationRequests
;; +    # [New in Gloas:EIP8282]
;; +    builder_deposits: BuilderDepositRequests
;; +    # [New in Gloas:EIP8282]
;; +    builder_exits: BuilderExitRequests

syntax executionRequests =
  { DEPOSITS depositRequest*,
    WITHDRAWALS withdrawalRequest*,
    CONSOLIDATIONS consolidationRequest* }

