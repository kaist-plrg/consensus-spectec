;;
;; Containers: defined as SpecTec struct types
;;

;; === beaconState type definitions ===

syntax fork =
  { PREVIOUS_VERSION version,
    CURRENT_VERSION version,
    EPOCH epoch }

syntax beaconBlockHeader =
  { SLOT slot,
    PROPOSER_INDEX validatorIndex,
    PARENT_ROOT root,
    STATE_ROOT root,
    BODY_ROOT root }

syntax eth1Data =
  { DEPOSIT_ROOT root,
    DEPOSIT_COUNT uint64,
    BLOCK_HASH hash32 }

syntax validator =
  { PUBKEY blsPubkey,
    WITHDRAWAL_CREDENTIALS bytes32,
    EFFECTIVE_BALANCE gwei,
    SLASHED bool,
    ACTIVATION_ELIGIBILITY_EPOCH epoch,
    ACTIVATION_EPOCH epoch,
    EXIT_EPOCH epoch,
    WITHDRAWABLE_EPOCH epoch }

syntax checkpoint =
  { EPOCH epoch,
    ROOT root }

syntax syncCommittee =
  { PUBKEYS blsPubkey*,
    AGGREGATE_PUBKEY blsPubkey }

;; TODO(gloas): ssz_objects `ExecutionPayloadHeader` removed upstream in specs/deneb/beacon-chain.md
;; edit the type/fields by hand; callers listed in PLAN.md
;; class ExecutionPayloadHeader(Container):
;;     parent_hash: Hash32
;;     fee_recipient: ExecutionAddress
;;     state_root: Bytes32
;;     receipts_root: Bytes32
;;     logs_bloom: LogsBloom
;;     prev_randao: Bytes32
;;     block_number: Uint64
;;     gas_limit: Uint64
;;     gas_used: Uint64
;;     timestamp: Uint64
;;     extra_data: ExtraData
;;     base_fee_per_gas: Uint256
;;     block_hash: Hash32
;;     transactions_root: Root
;;     withdrawals_root: Root
;;     # [New in Deneb:EIP4844]
;;     blob_gas_used: Uint64
;;     # [New in Deneb:EIP4844]
;;     excess_blob_gas: Uint64

syntax executionPayloadHeader =
  { PARENT_HASH hash32,
    FEE_RECIPIENT executionAddress,
    STATE_ROOT bytes32,
    RECEIPTS_ROOT bytes32,
    LOGS_BLOOM bytes256,
    PREV_RANDAO bytes32,
    BLOCK_NUMBER uint64,
    GAS_LIMIT uint64,
    GAS_USED uint64,
    TIMESTAMP uint64,
    EXTRA_DATA bytes,
    BASE_FEE_PER_GAS uint256,
    BLOCK_HASH hash32,
    TRANSACTIONS_ROOT root,
    WITHDRAWALS_ROOT root,
    ;;[Deneb] 
    BLOB_GAS_USED uint64,
    EXCESS_BLOB_GAS uint64 }

syntax historicalSummary =
  { BLOCK_SUMMARY_ROOT root,
    STATE_SUMMARY_ROOT root }

;; [Electra]
syntax pendingDeposit =
  { PUBKEY blsPubkey,
    WITHDRAWAL_CREDENTIALS bytes32,
    AMOUNT gwei,
    SIGNATURE blsSignature,
    SLOT slot }

;; [Electra]
syntax pendingPartialWithdrawal =
  { VALIDATOR_INDEX validatorIndex,
    AMOUNT gwei,
    WITHDRAWABLE_EPOCH epoch }

;; [Electra]
syntax pendingConsolidation =
  { SOURCE_INDEX validatorIndex,
    TARGET_INDEX validatorIndex }

