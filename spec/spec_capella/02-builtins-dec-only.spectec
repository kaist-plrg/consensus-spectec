;; =========================
;; builtins-decls.spectec
;; =========================

;; --- BLS cryptography ---
builtin dec $bls_verify(blsPubkey, root, blsSignature) : boolean
builtin dec $bls_fast_aggregate_verify(blsPubkey*, root, blsSignature) : boolean
builtin dec $eth_aggregate_pubkeys(blsPubkey*) : blsPubkey

;; hash
builtin dec $hash_<X>(X) : bytes32

;; Debug functions
builtin dec $debug_print_<X>(X) : X
builtin dec $debug_print_label_<X>(text, X) : X

;; --- hash_tree_root ---
builtin dec $hash_tree_root_beaconBlockHeader(beaconBlockHeader) : root
builtin dec $hash_tree_root_beaconBlockBody(beaconBlockBody) : root
builtin dec $hash_tree_root_depositData(depositData) : root
builtin dec $hash_tree_root_forkdata(forkdata) : root
builtin dec $hash_tree_root_beaconState(beaconState) : root
builtin dec $hash_tree_root_withdrawals(withdrawal*) : root
builtin dec $hash_tree_root_beaconBlock(beaconBlock) : root

builtin dec $hash_tree_root_roots(root*) : root
builtin dec $hash_tree_root_tx(bytes*) : root


;; --- compute signing root ---
builtin dec $compute_signing_root_epoch(epoch, domain) : root
builtin dec $compute_signing_root_voluntary_exit(voluntaryExit, domain) : root
builtin dec $compute_signing_root_bls_to_execution_change(blsToExecutionChange, domain) : root
builtin dec $compute_signing_root_beaconBlockHeader(beaconBlockHeader, domain) : root
builtin dec $compute_signing_root_attestationData(attestationData, domain) : root
builtin dec $compute_signing_root_depositMessage(depositMessage, domain) : root
builtin dec $compute_signing_root_block_root(bytes32, domain) : root
builtin dec $compute_signing_root_beaconBlock(beaconBlock, domain) : root

;; --- merkle validation ---
builtin dec $is_valid_merkle_branch(bytes32, bytes32*, uint64, uint64, root) : boolean

builtin dec $integer_square_root(uint64) : uint64

;; count occurrences of X in X*
builtin dec $count_occurrences_<X>(X*, X) : nat

;; --- pow2(nat) -> 2 ^ nat --- 
builtin dec $pow2(nat) : nat

;; dedup lists
builtin dec $to_set_<X>(X*) : X*

;; sum over list
builtin dec $sum_<X>(X*) : X

;; generate a list of X repeated nat times
builtin dec $repeat_<X>(X, nat) : X*

;; sort in ascending order
builtin dec $sort_<X>(X*) : X*

;; common elements in two lists
builtin dec $set_intersection_<X>(X*, X*) : X*

;; set_or_append_list : X* × nat × X → X*
;; if len(X*) == nat -> X*.append(X)
;; else X*[nat] = X
builtin dec $set_or_append_list_<X>(X*, nat, X) : X*


;; python for statement range funcs
builtin dec $range(nat) : nat*

;; enumerate
builtin dec $enumerate_<X>(X*) : enumerated_<X>*


;; --- byte utils ---
builtin dec $bytes_to_uint64(bytes32) : uint64
builtin dec $uint_to_bytes(uint) : bytes
builtin dec $xor(bytes32, bytes32) : bytes32
builtin dec $first_28_bytes(bytes32) : bytes28
builtin dec $get_first_byte(bytes32) : bytes1
builtin dec $strip_first_byte(bytes32) : bytes31
builtin dec $concat_domain(domainType, bytes28) : domain
builtin dec $make_withdrawal_credentials_eth1(executionAddress) : bytes32

;; Fixed-width Little-Endian encoders (for eth2spec compatibility)
builtin dec $uint8_to_bytes_le(uint8) : bytes
builtin dec $uint32_to_bytes_le(uint32) : bytes
builtin dec $uint64_to_bytes_le(uint64) : bytes
builtin dec $bytes32_prefix8(bytes32) : bytes
builtin dec $bytes8_to_uint64_le(bytes) : uint64

;; Bitwise operations
builtin dec $shr_uint64(uint64, nat) : uint64
builtin dec $and_uint64(uint64, uint64) : uint64

;; type conversions
builtin dec $bytes32_to_bytes1_list(bytes32) : bytes1*
builtin dec $bytes1_to_uint64(bytes1) : uint64

builtin dec $concat_bytes(bytes, bytes) : bytes

builtin dec $bytes32_to_bytes(bytes32) : bytes
builtin dec $bytes4_to_bytes(bytes4) : bytes

;; bytes32 withdrawal_credentials → executionAddress
;; bytes32 X -> X[12:] -> last 20 bytes
builtin dec $extract_execution_address(bytes32) : executionAddress
