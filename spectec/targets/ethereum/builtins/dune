(include_subdirs no)

(library
 (name builtin_eth)
 (public_name spectec.interp.builtins.eth)
 (libraries
  spectec.common
  spectec.lang
  spectec.interp.builtins
  bls12-381
  bls12-381-signature
  digestif.ocaml
  ssz
  ssz.schema
  yojson
  zarith))

; The per-fork SSZ schemas (spec/ssz/*.json), embedded as strings.

(rule
 (target ssz_schemas.ml)
 (deps
  (:capella_mainnet %{project_root}/spec/ssz/capella-mainnet.json)
  (:deneb_mainnet %{project_root}/spec/ssz/deneb-mainnet.json))
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let capella_mainnet = {json|")
    (cat %{capella_mainnet})
    (echo "|json}\nlet deneb_mainnet = {json|")
    (cat %{deneb_mainnet})
    (echo "|json}\n")))))
