var x : nat
var y : nat
var z : nat

relation Add:
  nat; nat |- nat
  hint(input %0 %1)

rule Add:
  x; y |- $(x + y)

relation Add_each:
  nat*; nat* |- nat*
  hint(input %0 %1)

rule Add_each:
  x*; y* |- z*
  -- (Add: x; y |- z)*

relation Identity:
  nat* |- nat*
  hint(input %0)

rule Identity:
  x* |- x*

relation Identity_nested:
  nat** |- nat**
  hint(input %0)

rule Identity_nested:
  x** |- x**
